fun Text.trimMargin(marker: Text = "|"): Text {
    let out = StringBuilder()
    var opening = true
    var started = false
    for line in this.split("\n") {
        let trimmed = line.trim()
        if opening and trimmed.length() == 0 {
            opening = false
            continue
        }
        opening = false
        if started { out.append("\n") }
        started = true
        if trimmed.startsWith(marker) {
            out.append(trimmed.substring(marker.length()))
        } else {
            out.append(line)
        }
    }
    let text = out.toString()
    if text.endsWith("\n") { return text.substring(0, text.length() - 1) }
    return text
}

class Regex(pattern: Text) {
    private let compiled: M__Pattern = M__Pattern.compile(pattern)
    fun matches(input: Text): Bool = compiled.matcher(input).matches()
    fun containsMatchIn(input: Text): Bool = compiled.matcher(input).find()
    fun replace(input: Text, replacement: Text): Text = compiled.matcher(input).replaceAll(replacement)
    fun split(input: Text): MutableList<Text> {
        let out = MutableList<Text>()
        for part in compiled.split(input) { out.add(part) }
        return out
    }
    fun findAll(input: Text): MutableList<Text> {
        let out = MutableList<Text>()
        let found = compiled.matcher(input)
        while found.find() { out.add(found.group()) }
        return out
    }
    fun find(input: Text): Text? {
        let found = compiled.matcher(input)
        if found.find() { return found.group() }
        return null
    }
}

fun Text.toRegex(): Regex = Regex(this)

class __SeqMap<__T, __R>(let source: __Iterator<__T>, let change: (__T) -> __R) implements __Iterator<__R> {
    override fun hasNext(): Bool = source.hasNext()
    override fun next(): __R = change(source.next())
}

class __SeqFilter<__T>(let source: __Iterator<__T>, let keep: (__T) -> Bool) implements __Iterator<__T> {
    private var ready = false
    private var held: __T? = null
    private fun advance() {
        while not ready and source.hasNext() {
            let candidate = source.next()
            if keep(candidate) {
                held = candidate
                ready = true
            }
        }
    }
    override fun hasNext(): Bool {
        advance()
        return ready
    }
    override fun next(): __T {
        advance()
        if not ready { throw __NoSuchElement("The sequence has no more items.") }
        ready = false
        return held!!
    }
}

class __SeqTake<__T>(let source: __Iterator<__T>, let limit: Int) implements __Iterator<__T> {
    private var taken = 0
    override fun hasNext(): Bool = taken < limit and source.hasNext()
    override fun next(): __T {
        if taken >= limit { throw __NoSuchElement("The sequence has no more items.") }
        taken += 1
        return source.next()
    }
}

class __SeqDrop<__T>(let source: __Iterator<__T>, let count: Int) implements __Iterator<__T> {
    private var dropped = false
    private fun advance() {
        if dropped { return }
        dropped = true
        var index = 0
        while index < count and source.hasNext() {
            source.next()
            index += 1
        }
    }
    override fun hasNext(): Bool {
        advance()
        return source.hasNext()
    }
    override fun next(): __T {
        advance()
        return source.next()
    }
}

class __SeqTakeWhile<__T>(let source: __Iterator<__T>, let keep: (__T) -> Bool) implements __Iterator<__T> {
    private var state = 0
    private var held: __T? = null
    private fun advance() {
        if state != 0 { return }
        if source.hasNext() {
            let candidate = source.next()
            if keep(candidate) {
                held = candidate
                state = 1
                return
            }
        }
        state = 2
    }
    override fun hasNext(): Bool {
        advance()
        return state == 1
    }
    override fun next(): __T {
        advance()
        if state != 1 { throw __NoSuchElement("The sequence has no more items.") }
        state = 0
        return held!!
    }
}

class __SeqGenerate<__T>(let seed: __T?, let step: (__T) -> __T?) implements __Iterator<__T> {
    private var upcoming: __T? = seed
    override fun hasNext(): Bool = upcoming != null
    override fun next(): __T {
        let value = upcoming
        if value == null { throw __NoSuchElement("The sequence has no more items.") }
        upcoming = step(value)
        return value
    }
}

class Sequence<__T>(let start: () -> __Iterator<__T>) implements Iterable<__T> {
    override fun iterator(): __Iterator<__T> = start()
    fun map<__R>(change: (__T) -> __R): Sequence<__R> {
        let open = start
        return Sequence<__R>({ __SeqMap<__T, __R>(open(), change) })
    }
    fun filter(keep: (__T) -> Bool): Sequence<__T> {
        let open = start
        return Sequence<__T>({ __SeqFilter<__T>(open(), keep) })
    }
    fun take(limit: Int): Sequence<__T> {
        let open = start
        return Sequence<__T>({ __SeqTake<__T>(open(), limit) })
    }
    fun drop(count: Int): Sequence<__T> {
        let open = start
        return Sequence<__T>({ __SeqDrop<__T>(open(), count) })
    }
    fun takeWhile(keep: (__T) -> Bool): Sequence<__T> {
        let open = start
        return Sequence<__T>({ __SeqTakeWhile<__T>(open(), keep) })
    }
    fun toList(): MutableList<__T> {
        let out = MutableList<__T>()
        for item in this { out.add(item) }
        return out
    }
}

fun Iterable<__T>.asSequence<__T>(): Sequence<__T> {
    let source = this
    return Sequence<__T>({ source.iterator() })
}

fun generateSequence<__T>(seed: __T?, step: (__T) -> __T?): Sequence<__T> {
    return Sequence<__T>({ __SeqGenerate<__T>(seed, step) })
}

