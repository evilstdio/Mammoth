fun Iterable<__T>.windowed<__T>(size: Int): MutableList<MutableList<__T>> {
    let items = MutableList<__T>()
    for item in this { items.add(item) }
    let out = MutableList<MutableList<__T>>()
    var start = 0
    while start + size <= items.size() {
        let window = MutableList<__T>()
        var index = start
        while index < start + size {
