fun readLine(): Text? {
    let bytes = __ByteOutput()
    var next = System.in.read()
    if next < 0 { return null }
    while next >= 0 and next != 10 {
        if next != 13 { bytes.write(next) }
        next = System.in.read()
    }
    return bytes.toString()
}

