fun Int.coerceIn(low: Int, high: Int): Int = if this < low { low } else if this > high { high } else { this }
fun Int.coerceAtLeast(low: Int): Int = if this < low { low } else { this }
fun Int.coerceAtMost(high: Int): Int = if this > high { high } else { this }
fun Long.coerceIn(low: Long, high: Long): Long = if this < low { low } else if this > high { high } else { this }
fun Long.coerceAtLeast(low: Long): Long = if this < low { low } else { this }
fun Long.coerceAtMost(high: Long): Long = if this > high { high } else { this }
fun Double.coerceIn(low: Double, high: Double): Double = if this < low { low } else if this > high { high } else { this }
fun Double.coerceAtLeast(low: Double): Double = if this < low { low } else { this }
fun Double.coerceAtMost(high: Double): Double = if this > high { high } else { this }
