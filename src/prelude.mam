fun __Map<__K, __V>.all<__K, __V>(predicate: (__Entry<__K, __V>) -> Bool): Bool {
    for entry in this.entrySet() {
        if not predicate(entry) { return false }
    }
    return true
}

fun __Map<__K, __V>.count<__K, __V>(predicate: (__Entry<__K, __V>) -> Bool): Int {
    var total = 0
    for entry in this.entrySet() {
        if predicate(entry) { total += 1 }
    }
    return total
}

fun __Map<__K, __V>.maxByOrNull<__K, __V, __R: Comparable<__R>>(selector: (__Entry<__K, __V>) -> __R): __Entry<__K, __V>? {
    var best: __Entry<__K, __V>? = null
    var score: __R? = null
    for entry in this.entrySet() {
        let value = selector(entry)
        let current = score
        if current == null or value.compareTo(current) > 0 {
            best = entry
            score = value
        }
    }
    return best
}

fun __Map<__K, __V>.toSortedMap<__K, __V>(): M__TreeMap<__K, __V> = M__TreeMap<__K, __V>(this)

fun __Map<__K, __V>.forEach<__K, __V>(action: (__Entry<__K, __V>) -> Unit) {
    for entry in this.entrySet() { action(entry) }
}

fun Text.substringBefore(separator: Text): Text {
    let at = this.indexOf(separator)
    return if at < 0 { this } else { this.substring(0, at) }
}

fun Text.substringAfter(separator: Text): Text {
    let at = this.indexOf(separator)
    return if at < 0 { this } else { this.substring(at + separator.length()) }
}

fun Text.substringBeforeLast(separator: Text): Text {
    let at = this.lastIndexOf(separator)
    return if at < 0 { this } else { this.substring(0, at) }
}

fun Text.substringAfterLast(separator: Text): Text {
    let at = this.lastIndexOf(separator)
    return if at < 0 { this } else { this.substring(at + separator.length()) }
}

fun Text.removePrefix(prefix: Text): Text = if this.startsWith(prefix) { this.substring(prefix.length()) } else { this }
fun Text.removeSuffix(suffix: Text): Text = if this.endsWith(suffix) { this.substring(0, this.length() - suffix.length()) } else { this }

fun Text.replaceFirstChar<__R>(change: (Char) -> __R): Text {
    if this.length() == 0 { return this }
    return "{change(this.charAt(0))}" + this.substring(1)
}

fun Text.chunked(size: Int): MutableList<Text> {
    let out = MutableList<Text>()
    var at = 0
    while at < this.length() {
        let end = if at + size < this.length() { at + size } else { this.length() }
        out.add(this.substring(at, end))
        at += size
    }
    return out
}

fun Text.toBoolean(): Bool = this.equalsIgnoreCase("true")

fun Text.toLongOrNull(): Long? {
    return try { java.lang.Long.parseLong(this) } catch (e: NumberFormatException) { null }
}

fun Text.toDoubleOrNull(): Double? {
    return try { java.lang.Double.parseDouble(this) } catch (e: NumberFormatException) { null }
}

fun Text.compareTo(other: Text, ignoreCase: Bool): Int = if ignoreCase { this.compareToIgnoreCase(other) } else { this.compareTo(other) }
fun Text.contains(other: Text, ignoreCase: Bool): Bool = if ignoreCase { this.toLowerCase().contains(other.toLowerCase()) } else { this.contains(other) }

fun Text.split(pattern: Regex): MutableList<Text> = pattern.split(this)
fun Text.replace(pattern: Regex, replacement: Text): Text = pattern.replace(this, replacement)

fun Double.roundToInt(): Int = java.lang.Math.round(this).toInt()
fun Double.pow(power: Double): Double = java.lang.Math.pow(this, power)
fun Double.pow(power: Int): Double = java.lang.Math.pow(this, power.toDouble())
let Int.absoluteValue: Int get() = java.lang.Math.abs(this)
let Long.absoluteValue: Long get() = java.lang.Math.abs(this)
let Double.absoluteValue: Double get() = java.lang.Math.abs(this)
fun Int.toString(radix: Int): Text = java.lang.Integer.toString(this, radix)

fun MutableList<__T>.component1<__T>(): __T = this[0]
fun MutableList<__T>.component2<__T>(): __T = this[1]
fun MutableList<__T>.component3<__T>(): __T = this[2]
fun MutableList<__T>.component4<__T>(): __T = this[3]
fun MutableList<__T>.component5<__T>(): __T = this[4]

fun Text.dropLast(count: Int): Text = if count >= this.length() { "" } else { this.substring(0, this.length() - count) }
fun Text.takeLast(count: Int): Text = if count >= this.length() { this } else { this.substring(this.length() - count) }

fun Iterable<__T>.filterIndexed<__T>(predicate: (Int, __T) -> Bool): MutableList<__T> {
    let out = MutableList<__T>()
    var index = 0
    for item in this {
        if predicate(index, item) { out.add(item) }
        index += 1
    }
    return out
}

fun Iterable<__T>.max<__T: Comparable<__T>>(): __T {
    var best: __T? = null
    for item in this {
        if best == null or item.compareTo(requireValue(best)) > 0 { best = item }
    }
    if best == null { throw __NoSuchElement("The collection is empty.") }
    return requireValue(best)
}
fun Iterable<__T>.min<__T: Comparable<__T>>(): __T {
    var best: __T? = null
    for item in this {
        if best == null or item.compareTo(requireValue(best)) < 0 { best = item }
    }
    if best == null { throw __NoSuchElement("The collection is empty.") }
    return requireValue(best)
}
fun Iterable<__T>.runningFold<__T, __R>(initial: __R, operation: (__R, __T) -> __R): MutableList<__R> {
    let out = MutableList<__R>()
    var result = initial
    out.add(result)
    for item in this {
        result = operation(result, item)
        out.add(result)
    }
    return out
}
fun Iterable<__T>.scan<__T, __R>(initial: __R, operation: (__R, __T) -> __R): MutableList<__R> {
    let out = MutableList<__R>()
    var result = initial
    out.add(result)
    for item in this {
        result = operation(result, item)
        out.add(result)
    }
    return out
}
fun Iterable<__T>.minus<__T>(element: __T): MutableList<__T> {
    let out = MutableList<__T>()
    var removed = false
    for item in this {
        if not removed and item == element { removed = true } else { out.add(item) }
    }
    return out
}
fun StringBuilder.appendLine(value: Any? = ""): StringBuilder {
    this.append(value)
    this.append("\n")
    return this
}
fun compareBy<__T, __K: Comparable<__K>, __L: Comparable<__L>>(first: (__T) -> __K, second: (__T) -> __L): __Comparator<__T> {
    return { a: __T, b: __T ->
        let order = first(a).compareTo(first(b))
        if order != 0 { order } else { second(a).compareTo(second(b)) }
    }
}

fun Iterable<Long>.toLongArray(): List<Long> {
    let items = MutableList<Long>()
    for item in this {
        items.add(item)
    }
    let out = List<Long>(items.size)
    var index = 0
    while index < items.size {
        out[index] = items[index]
        index += 1
    }
    return out
}

fun Iterable<Double>.toDoubleArray(): List<Double> {
    let items = MutableList<Double>()
    for item in this {
        items.add(item)
    }
    let out = List<Double>(items.size)
