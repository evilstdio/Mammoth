fun Iterable<__T>.zip<__T, __U>(other: Iterable<__U>): MutableList<Pair<__T, __U>> {
    let out = MutableList<Pair<__T, __U>>()
    let rest = other.iterator()
    for item in this {
        if not rest.hasNext() { break }
        out.add(Pair(item, rest.next()))
    }
    return out
}
