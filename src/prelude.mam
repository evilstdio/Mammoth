fun Text.isNotEmpty(): Bool { return this.length() > 0 }
fun Text.isNotBlank(): Bool { return this.trim().length() > 0 }
fun Text.take(count: Int): Text {
    if count >= this.length() { return this }
    return this.substring(0, count)
}
fun Text.drop(count: Int): Text {
    if count >= this.length() { return "" }
    return this.substring(count)
}
fun Text.reversed(): Text { return StringBuilder(this).reverse().toString() }
fun Text.padStart(length: Int, fill: Char = ' '): Text {
    let text = StringBuilder()
    var missing = length - this.length()
    while missing > 0 {
        text.append(fill)
        missing -= 1
    }
    text.append(this)
    return text.toString()
}
fun Text.padEnd(length: Int, fill: Char = ' '): Text {
    let text = StringBuilder(this)
    var missing = length - this.length()
    while missing > 0 {
        text.append(fill)
        missing -= 1
    }
    return text.toString()
}
