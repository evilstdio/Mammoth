module mammoth.Requests
import java.math.BigDecimal
import java.net.URI
import java.net.URISyntaxException
import java.net.URLEncoder
import java.net.http.HttpClient
import java.net.http.HttpRequest
import java.net.http.HttpRequest.BodyPublishers
import java.net.http.HttpResponse.BodyHandlers
import java.net.http.HttpTimeoutException
import java.nio.charset.Charset
import java.nio.charset.StandardCharsets
import java.util.concurrent.ExecutionException
import java.util.concurrent.TimeUnit
import java.util.concurrent.TimeoutException
import java.io.IOException
import java.io.InputStream
import java.util.concurrent.Executors
import java.util.concurrent.ScheduledExecutorService
import java.util.concurrent.atomic.AtomicBoolean
import java.util.List as JavaList
import java.time.Duration
import java.util.Collection as JavaCollection
import java.util.IdentityHashMap
import java.util.LinkedHashMap
import java.util.Map as JavaMap
import java.util.TreeMap

/// Every failure from this library. Messages never hold a URL, header or body.
/// `original` is the Java exception, kept off the cause chain so that a printed
/// stack trace cannot reveal what it says. Treat it as sensitive.
class RequestError(message: Text, let original: Throwable? = null) extends RuntimeException(message) {
    open fun errorName(): Text { return "RequestError" }
    override fun toString(): Text { return errorName() + ": " + getMessage() }
}

/// A request the library refuses to send, such as one with two kinds of body.
class InvalidRequestError(message: Text) extends RequestError(message) {
    override fun errorName(): Text { return "InvalidRequestError" }
}

/// The connection or the whole request took longer than allowed.
class TimeoutError(message: Text, original: Throwable? = null) extends RequestError(message, original) {
    override fun errorName(): Text { return "TimeoutError" }
}

/// The request could not be completed: refused, reset, or broken TLS.
class TransportError(message: Text, original: Throwable? = null) extends RequestError(message, original) {
    override fun errorName(): Text { return "TransportError" }
}

/// Thrown only by `raiseForStatus`. Other calls return error responses normally.
class HttpStatusError(let status: Int, let response: Response) extends RequestError("HTTP status {status}") {
    override fun errorName(): Text { return "HttpStatusError" }
}

/// Malformed JSON text, a value with no JSON form, or a read of the wrong type.
class JsonError(message: Text, let position: Int = -1) extends RequestError(message) {
    override fun errorName(): Text { return "JsonError" }
}

/// A JSON document. Objects keep their key order; a repeated key keeps its last value.
sealed class Json {
    open fun kind(): Text { return "value" }
    open fun isNull(): Bool { return false }
    open fun asBool(): Bool { throw wrong("a boolean") }
    open fun asText(): Text { throw wrong("text") }
    open fun asInt(): Int { throw wrong("a number") }
    open fun asLong(): Long { throw wrong("a number") }
    open fun asDouble(): Double { throw wrong("a number") }
    open fun asList(): MutableList<Json> { throw wrong("an array") }
    open fun asMap(): LinkedHashMap<Text, Json> { throw wrong("an object") }
    open fun size(): Int { throw wrong("an array or object") }
    open fun has(key: Text): Bool { throw wrong("an object") }
    open fun find(key: Text): Json? { throw wrong("an object") }
    operator fun get(key: Text): Json {
        let found = find(key)
        if found == null { throw JsonError("This JSON object has no such key.") }
        return found
    }
    operator fun get(index: Int): Json {
        let items = asList()
        if index < 0 or index >= items.size() { throw JsonError("This JSON array has no such index.") }
        return items[index]
    }
    fun wrong(wanted: Text): JsonError {
        return JsonError("Expected {wanted} in this JSON value, but it is {kind()}.")
    }
    open fun write(out: StringBuilder) {}
    override fun toString(): Text {
        let out = StringBuilder()
        write(out)
        return out.toString()
    }

    static let NULL: Json = JsonNull()
    /// Reads one JSON document. Throws JsonError if the text is not valid JSON.
    static fun parse(text: Text): Json { return JsonReader(text).document() }
    /// Converts text, booleans, finite numbers, null, maps with text keys,
    /// lists and arrays. Throws JsonError for anything else.
    static fun of(value: Any?): Json {
        return JsonBuilder().convert(value, 0)
    }
    /// The compact JSON text of a value accepted by `of`.
    static fun stringify(value: Any?): Text { return of(value).toString() }
    static fun emptyObject(): Json { return JsonObject(LinkedHashMap<Text, Json>()) }
    static fun emptyArray(): Json { return JsonArray(MutableList<Json>()) }
}

class JsonNull extends Json {
    override fun kind(): Text { return "null" }
    override fun isNull(): Bool { return true }
    override fun write(out: StringBuilder) { out.append("null") }
}

class JsonBool(let value: Bool) extends Json {
    override fun kind(): Text { return "a boolean" }
    override fun asBool(): Bool { return value }
    override fun write(out: StringBuilder) { out.append(if value { "true" } else { "false" }) }
}

/// Keeps the number exactly as written, so large values lose no precision.
class JsonNumber(let literal: Text) extends Json {
    override fun kind(): Text { return "a number" }
    override fun asInt(): Int {
        try {
            return exact().intValueExact()
        } catch (error: ArithmeticException) {
            throw JsonError("This JSON number is not an Int.")
        }
    }
    override fun asLong(): Long {
        try {
            return exact().longValueExact()
        } catch (error: ArithmeticException) {
            throw JsonError("This JSON number is not a Long.")
        }
    }
    override fun asDouble(): Double {
        let value = java.lang.Double.parseDouble(literal)
        if java.lang.Double.isInfinite(value) { throw JsonError("This JSON number is too large for a Double.") }
        return value
    }
    fun exact(): BigDecimal {
        if literal.length() > 400 { throw ArithmeticException() }
        try {
            return BigDecimal(literal)
        } catch (error: NumberFormatException) {
            throw ArithmeticException()
        }
    }
    override fun write(out: StringBuilder) { out.append(literal) }
}

class JsonText(let value: Text) extends Json {
    override fun kind(): Text { return "text" }
    override fun asText(): Text { return value }
    override fun write(out: StringBuilder) { writeJsonText(out, value) }
}

class JsonArray(let items: MutableList<Json>) extends Json {
    override fun kind(): Text { return "an array" }
    override fun asList(): MutableList<Json> { return MutableList<Json>(items) }
    override fun size(): Int { return items.size() }
    override fun write(out: StringBuilder) {
        out.append("[")
        var first = true
        for item in items {
            if not first { out.append(",") }
            first = false
            item.write(out)
        }
        out.append("]")
    }
}

class JsonObject(let fields: LinkedHashMap<Text, Json>) extends Json {
    override fun kind(): Text { return "an object" }
    override fun asMap(): LinkedHashMap<Text, Json> { return LinkedHashMap<Text, Json>(fields) }
    override fun size(): Int { return fields.size() }
    override fun has(key: Text): Bool { return fields.containsKey(key) }
    override fun find(key: Text): Json? { return fields.get(key) }
    override fun write(out: StringBuilder) {
        out.append("\{")
        var first = true
        for entry in fields.entrySet() {
            if not first { out.append(",") }
            first = false
            writeJsonText(out, entry.getKey())
            out.append(":")
            entry.getValue().write(out)
        }
        out.append("}")
    }
}

fun writeJsonText(out: StringBuilder, text: Text) {
    let hex = "0123456789abcdef"
    out.append("\"")
    var index = 0
    let length = text.length()
    while index < length {
        let ch = text.charAt(index)
        let code = ch.toInt()
        // A surrogate with no partner has no UTF-8 form, so it is escaped.
        let lonely = (code >= 55296 and code <= 56319
                and (index + 1 >= length or text.charAt(index + 1).toInt() < 56320 or text.charAt(index + 1).toInt() > 57343))
            or (code >= 56320 and code <= 57343
                and (index == 0 or text.charAt(index - 1).toInt() < 55296 or text.charAt(index - 1).toInt() > 56319))
        if code == 34 { out.append("\\\"") }
        else if code == 92 { out.append("\\\\") }
        else if code == 8 { out.append("\\b") }
        else if code == 9 { out.append("\\t") }
        else if code == 10 { out.append("\\n") }
        else if code == 12 { out.append("\\f") }
        else if code == 13 { out.append("\\r") }
        else if code < 32 or lonely {
            out.append("\\u")
            out.append(hex.charAt(code / 4096))
            out.append(hex.charAt(code / 256 % 16))
            out.append(hex.charAt(code / 16 % 16))
            out.append(hex.charAt(code % 16))
        } else { out.append(ch) }
        index += 1
    }
    out.append("\"")
}

class JsonLimits {
    static let MAX_DEPTH: Int = 512
}

class JsonBuilder {
    // The containers being converted, to find one that contains itself.
    let open = IdentityHashMap<Any, Bool>()

    fun convert(value: Any?, depth: Int): Json {
        if value == null { return Json.NULL }
        if value is Json { return value }
        if value is Text { return JsonText(value) }
        if value is Bool { return JsonBool(value) }
        if value is Char { return JsonText(value.toString()) }
        if value is Number {
            let literal = value.toString()
            if not JsonReader(literal).isNumber() { throw JsonError("This number has no JSON form (NaN and infinity are not JSON).") }
            return JsonNumber(literal)
        }
        let isMap = value is JavaMap<*, *>
        let isList = value is JavaCollection<*> or value.getClass().isArray()
        if not isMap and not isList {
            throw JsonError("A value of type {value.getClass().getSimpleName()} has no JSON form.")
        }
        if depth >= JsonLimits.MAX_DEPTH { throw JsonError("This value is nested too deeply for JSON.") }
        if open.containsKey(value) { throw JsonError("This value contains itself, so it has no JSON form.") }
        open.put(value, true)
        let result = if value is JavaMap<*, *> { fromMap(value, depth) } else { fromList(value, depth) }
        open.remove(value)
        return result
    }

    fun fromMap(values: JavaMap<*, *>, depth: Int): Json {
        let fields = LinkedHashMap<Text, Json>()
        for entry in values.entrySet() {
            let key = entry.getKey()
            if key is Text {
                fields.put(key, convert(entry.getValue(), depth + 1))
            } else {
                throw JsonError("JSON object keys must be text.")
            }
        }
        return JsonObject(fields)
    }

    fun fromList(values: Any, depth: Int): Json {
        let items = MutableList<Json>()
        if values is JavaCollection<*> {
            for item in values { items.add(convert(item, depth + 1)) }
        } else {
            let length = java.lang.reflect.Array.getLength(values)
            for index in 0 until length {
                items.add(convert(java.lang.reflect.Array.get(values, index), depth + 1))
            }
        }
        return JsonArray(items)
    }
}

class JsonReader(let source: Text) {
    var position = 0

    fun fail(message: Text): JsonError {
        return JsonError("Invalid JSON at character {position}: {message}.", position)
    }

    /// The character code here, or -1 at the end of the text.
    fun here(): Int {
        if position >= source.length() { return -1 }
        return source.charAt(position).toInt()
    }

    fun document(): Json {
        let value = read(0)
        skipSpace()
        if position != source.length() { throw fail("unexpected text after the value") }
        return value
    }

    fun isNumber(): Bool {
        try {
            number()
        } catch (error: JsonError) {
            return false
        }
        return position == source.length()
    }

    fun skipSpace() {
        while true {
            let code = here()
            if code != 32 and code != 10 and code != 13 and code != 9 { return }
            position += 1
        }
    }

    fun read(depth: Int): Json {
        if depth > JsonLimits.MAX_DEPTH { throw fail("nested too deeply") }
        skipSpace()
        let code = here()
        if code == 123 { return objectValue(depth) }
        if code == 91 { return arrayValue(depth) }
        if code == 34 { return JsonText(text()) }
        if code == 116 { return word("true", JsonBool(true)) }
        if code == 102 { return word("false", JsonBool(false)) }
        if code == 110 { return word("null", Json.NULL) }
        if code == -1 { throw fail("the text ended early") }
        return number()
    }

    fun word(expected: Text, value: Json): Json {
        if not source.startsWith(expected, position) { throw fail("expected {expected}") }
        position += expected.length()
        return value
    }

    fun objectValue(depth: Int): Json {
        position += 1
        let fields = LinkedHashMap<Text, Json>()
        skipSpace()
        if here() == 125 {
            position += 1
            return JsonObject(fields)
        }
        while true {
            skipSpace()
            if here() != 34 { throw fail("expected a key in double quotes") }
            let key = text()
            skipSpace()
            if here() != 58 { throw fail("expected ':' after the key") }
            position += 1
            fields.put(key, read(depth + 1))
            skipSpace()
            let code = here()
            position += 1
            if code == 125 { return JsonObject(fields) }
            if code != 44 {
                position -= 1
                throw fail("expected ',' or the end of the object")
            }
        }
    }

    fun arrayValue(depth: Int): Json {
        position += 1
        let items = MutableList<Json>()
        skipSpace()
        if here() == 93 {
            position += 1
            return JsonArray(items)
        }
        while true {
            items.add(read(depth + 1))
            skipSpace()
            let code = here()
            position += 1
            if code == 93 { return JsonArray(items) }
            if code != 44 {
                position -= 1
                throw fail("expected ',' or the end of the array")
            }
        }
    }

    fun text(): Text {
        position += 1
        let out = StringBuilder()
        while true {
            let code = here()
            if code == -1 { throw fail("the text ended inside a string") }
            if code < 32 { throw fail("a control character must be escaped") }
            position += 1
            if code == 34 { return out.toString() }
            if code == 92 {
                escape(out)
            } else {
                out.append(source.charAt(position - 1))
            }
        }
    }

    fun escape(out: StringBuilder) {
        let code = here()
        position += 1
        if code == 34 { out.append('"') }
        else if code == 92 { out.append('\\') }
        else if code == 47 { out.append('/') }
        else if code == 98 { out.append(8.toChar()) }
        else if code == 102 { out.append(12.toChar()) }
        else if code == 110 { out.append(10.toChar()) }
        else if code == 114 { out.append(13.toChar()) }
        else if code == 116 { out.append(9.toChar()) }
        else if code == 117 {
            var value = 0
            for i in 0 until 4 { value = value * 16 + hexDigit() }
            out.append(value.toChar())
        } else {
            position -= 1
            throw fail("this escape does not exist")
        }
    }

    fun hexDigit(): Int {
        let code = here()
        var digit = -1
        if code >= 48 and code <= 57 { digit = code - 48 }
        else if code >= 97 and code <= 102 { digit = code - 87 }
        else if code >= 65 and code <= 70 { digit = code - 55 }
        if digit < 0 { throw fail("expected four hexadecimal digits") }
        position += 1
        return digit
    }

    fun digits(): Bool {
        let start = position
        while here() >= 48 and here() <= 57 { position += 1 }
        return position > start
    }

    fun number(): Json {
        let start = position
        if here() == 45 { position += 1 }
        if here() == 48 {
            position += 1
            if here() >= 48 and here() <= 57 { throw fail("a number cannot start with zero") }
        } else if not digits() {
            throw fail("expected a value")
        }
        if here() == 46 {
            position += 1
            if not digits() { throw fail("expected digits after the decimal point") }
        }
        if here() == 101 or here() == 69 {
            position += 1
            if here() == 43 or here() == 45 { position += 1 }
            if not digits() { throw fail("expected digits in the exponent") }
        }
        return JsonNumber(source.substring(start, position))
    }
}

/// Response headers. Names match in any case.
class Headers(source: JavaMap<Text, JavaList<Text>>) {
    private let values = TreeMap<Text, JavaList<Text>>(java.lang.String.CASE_INSENSITIVE_ORDER)
    init {
        values.putAll(source)
    }
    /// The first value of a header, or null if it is absent.
    operator fun get(name: Text): Text? {
        let found: JavaList<Text>? = values.get(name)
        if found == null or found.isEmpty() { return null }
        return found.get(0)
    }
    /// Every value of a header, in the order received.
    fun all(name: Text): MutableList<Text> {
        let result = MutableList<Text>()
        let found: JavaList<Text>? = values.get(name)
        if found != null { result.addAll(found) }
        return result
    }
    fun has(name: Text): Bool { return values.containsKey(name) }
    fun names(): MutableList<Text> {
        let result = MutableList<Text>()
        result.addAll(values.keySet())
        return result
    }
    override fun toString(): Text { return "Headers({values.size()} names)" }
}

/// A finished HTTP exchange. Status 4xx and 5xx are ordinary responses.
class Response(let status: Int, let bytes: ByteArray, let headers: Headers, let url: Text) {
    let ok: Bool = status >= 200 and status < 300
    /// The body as text, using the charset the server named, or UTF-8.
    let text: Text get() = java.lang.String(bytes, charset())
    private fun charset(): Charset {
        let type = headers["Content-Type"]
        if type != null {
            for part in type.split(";") {
                let item = part.trim()
                if item.regionMatches(true, 0, "charset=", 0, 8) {
                    try {
                        return Charset.forName(item.substring(8).replace("\"", "").trim())
                    } catch (error: IllegalArgumentException) {
                        return StandardCharsets.UTF_8
                    }
                }
            }
        }
        return StandardCharsets.UTF_8
    }
    /// The first value of a header, or null. Names match in any case.
    fun header(name: Text): Text? { return headers[name] }
    /// Reads the body as JSON. Throws JsonError if it is not valid JSON.
    fun json(): Json { return Json.parse(text) }
    /// Throws HttpStatusError unless the status is 2xx.
    fun raiseForStatus() {
        if not ok { throw HttpStatusError(status, this) }
    }
    override fun toString(): Text { return "Response({status})" }
}

class Http {
    private static let client: HttpClient = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10L)).build()
    // One daemon thread enforces body deadlines for every request.
    private static let timer: ScheduledExecutorService = Executors.newSingleThreadScheduledExecutor { task ->
        let thread = Thread(task, "mammoth-requests-timer")
        thread.setDaemon(true)
        thread
    }

    /// Checks a URL without ever quoting it, since URLs can hold secrets.
    static fun checkUrl(url: Text): URI {
        var parsed: URI? = null
        try {
            parsed = URI(url)
        } catch (error: URISyntaxException) {
            throw InvalidRequestError("This URL is not valid. Encode any spaces or special characters.")
        }
        let uri = parsed!!
        let scheme = uri.getScheme()
        if scheme == null or (not scheme.equalsIgnoreCase("http") and not scheme.equalsIgnoreCase("https")) {
            throw InvalidRequestError("Only http and https URLs are supported.")
        }
        if uri.getHost() == null { throw InvalidRequestError("This URL has no host.") }
        if uri.getRawUserInfo() != null { throw InvalidRequestError("Do not put credentials in a URL. Send them in a header.") }
        return uri
    }

    private static fun encode(text: Text, plus: Bool): Text {
        let encoded = URLEncoder.encode(text, StandardCharsets.UTF_8)
        return if plus { encoded } else { encoded.replace("+", "%20") }
    }

    private static fun plainValue(value: Any?): Text {
        if value is Text { return value }
        if value != null and (value is Bool or value is Number or value is Char) { return value.toString() }
        throw InvalidRequestError("Query and form values must be text, numbers, booleans or lists of those.")
    }

    /// `a=1&b=2`, with a list value repeating its key.
    static fun encodePairs(values: JavaMap<Text, *>, plus: Bool): Text {
        let out = StringBuilder()
        for entry in values.entrySet() {
            let key = encode(entry.getKey(), plus)
            let value = entry.getValue()
            var items = MutableList<Any?>()
            if value is JavaCollection<*> {
                for item in value { items.add(item) }
            } else if value != null and value.getClass().isArray() {
                let length = java.lang.reflect.Array.getLength(value)
                for index in 0 until length { items.add(java.lang.reflect.Array.get(value, index)) }
            } else {
                items.add(value)
            }
            for item in items {
                if out.length() > 0 { out.append("&") }
                out.append(key)
                out.append("=")
                out.append(encode(plainValue(item), plus))
            }
        }
        return out.toString()
    }

    /// The URL with `params` added to any query it has, before any fragment.
    static fun withQuery(url: Text, params: JavaMap<Text, *>?): Text {
        if params == null { return url }
        let query = encodePairs(params, false)
        if query.isEmpty() { return url }
        let mark = url.indexOf("#")
        let start = if mark < 0 { url } else { url.substring(0, mark) }
        let fragment = if mark < 0 { "" } else { url.substring(mark) }
        let joiner = if start.indexOf("?") < 0 { "?" } else if start.endsWith("?") or start.endsWith("&") { "" } else { "&" }
        return start + joiner + query + fragment
    }

    private static fun isToken(text: Text): Bool {
        if text.isEmpty() { return false }
        let allowed = "!#$%&'*+-.^_`|~"
        for ch in text.toCharArray() {
            let code = ch.toInt()
            let alphanumeric = (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
            if not alphanumeric and allowed.indexOf(ch.toString()) < 0 { return false }
        }
        return true
    }

    private static fun checkHeader(name: Text, value: Text) {
        if not isToken(name) { throw InvalidRequestError("A header name contains a character that is not allowed.") }
        for ch in value.toCharArray() {
            let code = ch.toInt()
            if code == 13 or code == 10 or code == 0 { throw InvalidRequestError("A header value contains a line break or NUL.") }
        }
        let lower = name.toLowerCase()
        if lower == "connection" or lower == "content-length" or lower == "expect" or lower == "host" or lower == "upgrade" {
            throw InvalidRequestError("The {name} header is managed by the HTTP client and cannot be set.")
        }
    }

    static fun request(
        method: Text, url: Text, timeout: Int, params: JavaMap<Text, *>?, headers: JavaMap<Text, Text>?,
        json: Any?, text: Text?, bytes: ByteArray?, form: JavaMap<Text, *>?
    ): Response {
        if timeout <= 0 { throw InvalidRequestError("Timeout must be positive (seconds).") }
        let verb = method.toUpperCase()
        if not isToken(verb) { throw InvalidRequestError("This is not a valid HTTP method.") }
        checkUrl(url)
        var kinds = 0
        if json != null { kinds += 1 }
        if text != null { kinds += 1 }
        if bytes != null { kinds += 1 }
        if form != null { kinds += 1 }
        if kinds > 1 { throw InvalidRequestError("Give only one of json, text, bytes or form.") }

        let names = TreeMap<Text, Text>(java.lang.String.CASE_INSENSITIVE_ORDER)
        var publisher = BodyPublishers.noBody()
        if json != null {
            names.put("Content-Type", "application/json; charset=utf-8")
            publisher = BodyPublishers.ofString(Json.stringify(json), StandardCharsets.UTF_8)
        } else if text != null {
            names.put("Content-Type", "text/plain; charset=utf-8")
            publisher = BodyPublishers.ofString(text, StandardCharsets.UTF_8)
        } else if bytes != null {
            names.put("Content-Type", "application/octet-stream")
            publisher = BodyPublishers.ofByteArray(bytes)
        } else if form != null {
            names.put("Content-Type", "application/x-www-form-urlencoded")
            publisher = BodyPublishers.ofString(encodePairs(form, true), StandardCharsets.UTF_8)
        }
        if headers != null {
            for entry in headers.entrySet() {
                checkHeader(entry.getKey(), entry.getValue())
                names.put(entry.getKey(), entry.getValue())
            }
        }
        // Adding the query can't make a checked URL invalid, but parse the result.
        let target = checkUrl(withQuery(url, params))
        let finalUrl = target.toString()
        try {
            let builder = HttpRequest.newBuilder(target).timeout(Duration.ofSeconds(timeout.toLong()))
            for entry in names.entrySet() { builder.setHeader(entry.getKey(), entry.getValue()) }
            builder.method(verb, publisher)
            let started = System.nanoTime()
            let limit = TimeUnit.SECONDS.toNanos(timeout.toLong())
            let sent = client.sendAsync(builder.build(), BodyHandlers.ofInputStream())
            try {
                let reply = sent.get(limit, TimeUnit.NANOSECONDS)
                // Java's own timeout stops at the headers. The body gets what is left.
                let body = readAll(reply.body(), limit - (System.nanoTime() - started), timeout)
                return Response(reply.statusCode(), body, Headers(reply.headers().map()), finalUrl)
            } catch (error: TimeoutException) {
                sent.cancel(true)
                throw TimeoutError("HTTP request timed out after {timeout} seconds.", error)
            } catch (error: ExecutionException) {
                throw translate(error.getCause())
            } catch (error: InterruptedException) {
                sent.cancel(true)
                Thread.currentThread().interrupt()
                throw RequestError("HTTP request interrupted.")
            }
        } catch (error: RequestError) {
            throw error
        } catch (error: RuntimeException) {
            throw RequestError("The HTTP request could not be built (" + error.getClass().getSimpleName() + ").")
        }
    }

    private static fun closeQuietly(stream: InputStream) {
        try {
            stream.close()
        } catch (error: IOException) {
        }
    }

    /// Reads to the end. At the deadline the stream is closed, which ends a blocked read.
    private static fun readAll(stream: InputStream, nanos: Long, timeout: Int): ByteArray {
        let expired = AtomicBoolean(false)
        let alarm = timer.schedule(Runnable {
            expired.set(true)
            closeQuietly(stream)
        }, if nanos > 0L { nanos } else { 0L }, TimeUnit.NANOSECONDS)
        try {
            let data = stream.readAllBytes()
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.") }
            return data
        } catch (error: IOException) {
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.", error) }
            throw translate(error)
        } finally {
            alarm.cancel(false)
            closeQuietly(stream)
        }
    }

    private static fun translate(error: Throwable?): RequestError {
        if error is HttpTimeoutException {
            return TimeoutError("HTTP request timed out (" + error.getClass().getSimpleName() + ").", error)
        }
        if error is IOException {
            return TransportError("HTTP request failed (" + error.getClass().getSimpleName() + ").", error)
        }
        return RequestError("HTTP request failed.")
    }
}

/// Simple calls: `requests.get(url)`, `requests.post(url, json = value)`.
/// Everything after the URL can be given by name. A method takes any body.
class requests {
    static fun request(method: Text, url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request(method, url, timeout, params, headers, json, text, bytes, form)
    }
    static fun get(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("GET", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun head(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("HEAD", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun options(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("OPTIONS", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun delete(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("DELETE", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun post(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("POST", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun put(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("PUT", url, timeout, params, headers, json, text, bytes, form)
    }
    static fun patch(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null): Response {
        return Http.request("PATCH", url, timeout, params, headers, json, text, bytes, form)
    }
}
