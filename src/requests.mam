/// Every failure from this library. Messages never hold a URL, header or body.
/// `original` is the Java exception, kept off the cause chain so that a printed
/// stack trace cannot reveal what it says. Treat it as sensitive.
class RequestError(message: Text, let original: Throwable? = null) extends RuntimeException(message) {
    open fun errorName(): Text { return "RequestError" }
    override fun toString(): Text { return errorName() + ": " + getMessage() }
}

/// A request the library refuses to send, such as one with two kinds of body.
class InvalidRequestError(message: Text) extends RequestError(message) {
    override fun errorName(): Text { return "InvalidRequestError" }
}

/// The connection or the whole request took longer than allowed.
class TimeoutError(message: Text, original: Throwable? = null) extends RequestError(message, original) {
    override fun errorName(): Text { return "TimeoutError" }
}

/// The request could not be completed: refused, reset, or broken TLS.
class TransportError(message: Text, original: Throwable? = null) extends RequestError(message, original) {
    override fun errorName(): Text { return "TransportError" }
}

/// A redirect that was not followed: too many, malformed, or unsafe to send on.
class RedirectError(message: Text) extends RequestError(message) {
    override fun errorName(): Text { return "RedirectError" }
}

/// Thrown only by `raiseForStatus`. Other calls return error responses normally.
class HttpStatusError(let status: Int, let response: Response) extends RequestError("HTTP status {status}") {
    override fun errorName(): Text { return "HttpStatusError" }
}

/// Malformed JSON text, a value with no JSON form, or a read of the wrong type.
class JsonError(message: Text, let position: Int = -1) extends RequestError(message) {
    override fun errorName(): Text { return "JsonError" }
}

/// A JSON document. Objects keep their key order; a repeated key keeps its last value.
sealed class Json {
    open fun kind(): Text { return "value" }
    open fun isNull(): Bool { return false }
    open fun asBool(): Bool { throw wrong("a boolean") }
    open fun asText(): Text { throw wrong("text") }
    open fun asInt(): Int { throw wrong("a number") }
    open fun asLong(): Long { throw wrong("a number") }
    open fun asDouble(): Double { throw wrong("a number") }
    open fun asList(): MutableList<Json> { throw wrong("an array") }
    open fun asMap(): LinkedHashMap<Text, Json> { throw wrong("an object") }
    open fun size(): Int { throw wrong("an array or object") }
    open fun has(key: Text): Bool { throw wrong("an object") }
    open fun find(key: Text): Json? { throw wrong("an object") }
    operator fun get(key: Text): Json {
        let found = find(key)
        if found == null { throw JsonError("This JSON object has no such key.") }
        return found
    }
    operator fun get(index: Int): Json {
        let items = asList()
        if index < 0 or index >= items.size() { throw JsonError("This JSON array has no such index.") }
        return items[index]
    }
    fun wrong(wanted: Text): JsonError {
        return JsonError("Expected {wanted} in this JSON value, but it is {kind()}.")
    }
    open fun write(out: StringBuilder) {}
    override fun toString(): Text {
        let out = StringBuilder()
        write(out)
        return out.toString()
    }

    static let NULL: Json = JsonNull()
    /// Reads one JSON document. Throws JsonError if the text is not valid JSON.
    static fun parse(text: Text): Json { return JsonReader(text).document() }
    /// Converts text, booleans, finite numbers, null, maps with text keys,
    /// lists and arrays. Throws JsonError for anything else.
    static fun of(value: Any?): Json {
        return JsonBuilder().convert(value, 0)
    }
    /// The compact JSON text of a value accepted by `of`.
    static fun stringify(value: Any?): Text { return of(value).toString() }
    static fun emptyObject(): Json { return JsonObject(LinkedHashMap<Text, Json>()) }
    static fun emptyArray(): Json { return JsonArray(MutableList<Json>()) }
}

class JsonNull extends Json {
    override fun kind(): Text { return "null" }
    override fun isNull(): Bool { return true }
    override fun write(out: StringBuilder) { out.append("null") }
}

class JsonBool(let value: Bool) extends Json {
    override fun kind(): Text { return "a boolean" }
    override fun asBool(): Bool { return value }
    override fun write(out: StringBuilder) { out.append(if value { "true" } else { "false" }) }
}

/// Keeps the number exactly as written, so large values lose no precision.
class JsonNumber(let literal: Text) extends Json {
    override fun kind(): Text { return "a number" }
    override fun asInt(): Int {
        try {
            return exact().intValueExact()
        } catch (error: ArithmeticException) {
            throw JsonError("This JSON number is not an Int.")
        }
    }
    override fun asLong(): Long {
        try {
            return exact().longValueExact()
        } catch (error: ArithmeticException) {
            throw JsonError("This JSON number is not a Long.")
        }
    }
    override fun asDouble(): Double {
        let value = java.lang.Double.parseDouble(literal)
        if java.lang.Double.isInfinite(value) { throw JsonError("This JSON number is too large for a Double.") }
        return value
    }
    fun exact(): BigDecimal {
        if literal.length() > 400 { throw ArithmeticException() }
        try {
            return BigDecimal(literal)
        } catch (error: NumberFormatException) {
            throw ArithmeticException()
        }
    }
    override fun write(out: StringBuilder) { out.append(literal) }
}

class JsonText(let value: Text) extends Json {
    override fun kind(): Text { return "text" }
    override fun asText(): Text { return value }
    override fun write(out: StringBuilder) { writeJsonText(out, value) }
}

class JsonArray(let items: MutableList<Json>) extends Json {
    override fun kind(): Text { return "an array" }
    override fun asList(): MutableList<Json> { return MutableList<Json>(items) }
    override fun size(): Int { return items.size() }
    override fun write(out: StringBuilder) {
        out.append("[")
        var first = true
        for item in items {
            if not first { out.append(",") }
            first = false
            item.write(out)
        }
        out.append("]")
    }
}

class JsonObject(let fields: LinkedHashMap<Text, Json>) extends Json {
    override fun kind(): Text { return "an object" }
    override fun asMap(): LinkedHashMap<Text, Json> { return LinkedHashMap<Text, Json>(fields) }
    override fun size(): Int { return fields.size() }
    override fun has(key: Text): Bool { return fields.containsKey(key) }
    override fun find(key: Text): Json? { return fields.get(key) }
    override fun write(out: StringBuilder) {
        out.append("\{")
        var first = true
        for entry in fields.entrySet() {
            if not first { out.append(",") }
            first = false
            writeJsonText(out, entry.getKey())
            out.append(":")
            entry.getValue().write(out)
        }
        out.append("}")
    }
}

fun writeJsonText(out: StringBuilder, text: Text) {
    let hex = "0123456789abcdef"
    out.append("\"")
    var index = 0
    let length = text.length()
    while index < length {
        let ch = text.charAt(index)
        let code = ch.toInt()
        // A surrogate with no partner has no UTF-8 form, so it is escaped.
        let lonely = (code >= 55296 and code <= 56319
                and (index + 1 >= length or text.charAt(index + 1).toInt() < 56320 or text.charAt(index + 1).toInt() > 57343))
            or (code >= 56320 and code <= 57343
                and (index == 0 or text.charAt(index - 1).toInt() < 55296 or text.charAt(index - 1).toInt() > 56319))
        if code == 34 { out.append("\\\"") }
        else if code == 92 { out.append("\\\\") }
        else if code == 8 { out.append("\\b") }
        else if code == 9 { out.append("\\t") }
        else if code == 10 { out.append("\\n") }
        else if code == 12 { out.append("\\f") }
        else if code == 13 { out.append("\\r") }
        else if code < 32 or lonely {
            out.append("\\u")
            out.append(hex.charAt(code / 4096))
            out.append(hex.charAt(code / 256 % 16))
            out.append(hex.charAt(code / 16 % 16))
            out.append(hex.charAt(code % 16))
        } else { out.append(ch) }
        index += 1
    }
    out.append("\"")
}

class JsonLimits {
    static let MAX_DEPTH: Int = 512
}

class JsonBuilder {
    // The containers being converted, to find one that contains itself.
    let open = IdentityHashMap<Any, Bool>()

    fun convert(value: Any?, depth: Int): Json {
        if value == null { return Json.NULL }
        if value is Json { return value }
        if value is Text { return JsonText(value) }
        if value is Bool { return JsonBool(value) }
        if value is Char { return JsonText(value.toString()) }
        if value is Number {
            let literal = value.toString()
            if not JsonReader(literal).isNumber() { throw JsonError("This number has no JSON form (NaN and infinity are not JSON).") }
            return JsonNumber(literal)
        }
        let isMap = value is JavaMap<*, *>
        let isList = value is JavaCollection<*> or value.getClass().isArray()
        if not isMap and not isList {
            throw JsonError("A value of type {value.getClass().getSimpleName()} has no JSON form.")
        }
        if depth >= JsonLimits.MAX_DEPTH { throw JsonError("This value is nested too deeply for JSON.") }
        if open.containsKey(value) { throw JsonError("This value contains itself, so it has no JSON form.") }
        open.put(value, true)
        let result = if value is JavaMap<*, *> { fromMap(value, depth) } else { fromList(value, depth) }
        open.remove(value)
        return result
    }

    fun fromMap(values: JavaMap<*, *>, depth: Int): Json {
        let fields = LinkedHashMap<Text, Json>()
        for entry in values.entrySet() {
            let key = entry.getKey()
            if key is Text {
                fields.put(key, convert(entry.getValue(), depth + 1))
            } else {
                throw JsonError("JSON object keys must be text.")
            }
        }
        return JsonObject(fields)
    }

    fun fromList(values: Any, depth: Int): Json {
        let items = MutableList<Json>()
        if values is JavaCollection<*> {
            for item in values { items.add(convert(item, depth + 1)) }
        } else {
            let length = java.lang.reflect.Array.getLength(values)
            for index in 0 until length {
                items.add(convert(java.lang.reflect.Array.get(values, index), depth + 1))
            }
        }
        return JsonArray(items)
    }
}

class JsonReader(let source: Text) {
    var position = 0

    fun fail(message: Text): JsonError {
        return JsonError("Invalid JSON at character {position}: {message}.", position)
    }

    /// The character code here, or -1 at the end of the text.
    fun here(): Int {
        if position >= source.length() { return -1 }
        return source.charAt(position).toInt()
    }

    fun document(): Json {
        let value = read(0)
        skipSpace()
        if position != source.length() { throw fail("unexpected text after the value") }
        return value
    }

    fun isNumber(): Bool {
        try {
            number()
        } catch (error: JsonError) {
            return false
        }
        return position == source.length()
    }

    fun skipSpace() {
        while true {
            let code = here()
            if code != 32 and code != 10 and code != 13 and code != 9 { return }
            position += 1
        }
    }

    fun read(depth: Int): Json {
        if depth > JsonLimits.MAX_DEPTH { throw fail("nested too deeply") }
        skipSpace()
        let code = here()
        if code == 123 { return objectValue(depth) }
        if code == 91 { return arrayValue(depth) }
        if code == 34 { return JsonText(text()) }
        if code == 116 { return word("true", JsonBool(true)) }
        if code == 102 { return word("false", JsonBool(false)) }
        if code == 110 { return word("null", Json.NULL) }
        if code == -1 { throw fail("the text ended early") }
        return number()
    }

    fun word(expected: Text, value: Json): Json {
        if not source.startsWith(expected, position) { throw fail("expected {expected}") }
        position += expected.length()
        return value
    }

    fun objectValue(depth: Int): Json {
        position += 1
        let fields = LinkedHashMap<Text, Json>()
        skipSpace()
        if here() == 125 {
            position += 1
            return JsonObject(fields)
        }
        while true {
            skipSpace()
            if here() != 34 { throw fail("expected a key in double quotes") }
            let key = text()
            skipSpace()
            if here() != 58 { throw fail("expected ':' after the key") }
            position += 1
            fields.put(key, read(depth + 1))
            skipSpace()
            let code = here()
            position += 1
            if code == 125 { return JsonObject(fields) }
            if code != 44 {
                position -= 1
                throw fail("expected ',' or the end of the object")
            }
        }
    }

    fun arrayValue(depth: Int): Json {
        position += 1
        let items = MutableList<Json>()
        skipSpace()
        if here() == 93 {
            position += 1
            return JsonArray(items)
        }
        while true {
            items.add(read(depth + 1))
            skipSpace()
            let code = here()
            position += 1
            if code == 93 { return JsonArray(items) }
            if code != 44 {
                position -= 1
                throw fail("expected ',' or the end of the array")
            }
        }
    }

    fun text(): Text {
        position += 1
        let out = StringBuilder()
        while true {
            let code = here()
            if code == -1 { throw fail("the text ended inside a string") }
            if code < 32 { throw fail("a control character must be escaped") }
            position += 1
            if code == 34 { return out.toString() }
            if code == 92 {
                escape(out)
            } else {
                out.append(source.charAt(position - 1))
            }
        }
    }

    fun escape(out: StringBuilder) {
        let code = here()
        position += 1
        if code == 34 { out.append('"') }
        else if code == 92 { out.append('\\') }
        else if code == 47 { out.append('/') }
        else if code == 98 { out.append(8.toChar()) }
        else if code == 102 { out.append(12.toChar()) }
        else if code == 110 { out.append(10.toChar()) }
        else if code == 114 { out.append(13.toChar()) }
        else if code == 116 { out.append(9.toChar()) }
        else if code == 117 {
            var value = 0
            for i in 0 until 4 { value = value * 16 + hexDigit() }
            out.append(value.toChar())
        } else {
            position -= 1
            throw fail("this escape does not exist")
        }
    }

    fun hexDigit(): Int {
        let code = here()
        var digit = -1
        if code >= 48 and code <= 57 { digit = code - 48 }
        else if code >= 97 and code <= 102 { digit = code - 87 }
        else if code >= 65 and code <= 70 { digit = code - 55 }
        if digit < 0 { throw fail("expected four hexadecimal digits") }
        position += 1
        return digit
    }

    fun digits(): Bool {
        let start = position
        while here() >= 48 and here() <= 57 { position += 1 }
        return position > start
    }

    fun number(): Json {
        let start = position
        if here() == 45 { position += 1 }
        if here() == 48 {
            position += 1
            if here() >= 48 and here() <= 57 { throw fail("a number cannot start with zero") }
        } else if not digits() {
            throw fail("expected a value")
        }
        if here() == 46 {
            position += 1
            if not digits() { throw fail("expected digits after the decimal point") }
        }
        if here() == 101 or here() == 69 {
            position += 1
            if here() == 43 or here() == 45 { position += 1 }
            if not digits() { throw fail("expected digits in the exponent") }
        }
        return JsonNumber(source.substring(start, position))
    }
}

/// Response headers. Names match in any case.
class Headers(source: JavaMap<Text, JavaList<Text>>) {
    private let values = TreeMap<Text, JavaList<Text>>(java.lang.String.CASE_INSENSITIVE_ORDER)
    init {
        values.putAll(source)
    }
    /// The first value of a header, or null if it is absent.
    operator fun get(name: Text): Text? {
        let found: JavaList<Text>? = values.get(name)
        if found == null or found.isEmpty() { return null }
        return found.get(0)
    }
    /// Every value of a header, in the order received.
    fun all(name: Text): MutableList<Text> {
        let result = MutableList<Text>()
        let found: JavaList<Text>? = values.get(name)
        if found != null { result.addAll(found) }
        return result
    }
    fun has(name: Text): Bool { return values.containsKey(name) }
    fun names(): MutableList<Text> {
        let result = MutableList<Text>()
        result.addAll(values.keySet())
        return result
    }
    override fun toString(): Text { return "Headers({values.size()} names)" }
}

/// A finished HTTP exchange. Status 4xx and 5xx are ordinary responses.
class Response(let status: Int, let bytes: ByteArray, let headers: Headers, let url: Text, let savedTo: Text? = null) {
    let ok: Bool = status >= 200 and status < 300
    /// The body as text, using the charset the server named, or UTF-8.
    let text: Text get() = java.lang.String(bytes, charset())
    private fun charset(): Charset {
        let type = headers["Content-Type"]
        if type != null {
            for part in type.split(";") {
                let item = part.trim()
                if item.regionMatches(true, 0, "charset=", 0, 8) {
                    try {
                        return Charset.forName(item.substring(8).replace("\"", "").trim())
                    } catch (error: IllegalArgumentException) {
                        return StandardCharsets.UTF_8
                    }
                }
            }
        }
        return StandardCharsets.UTF_8
    }
    /// The first value of a header, or null. Names match in any case.
    fun header(name: Text): Text? { return headers[name] }
    /// Reads the body as JSON. Throws JsonError if it is not valid JSON.
    fun json(): Json { return Json.parse(text) }
    /// Throws HttpStatusError unless the status is 2xx.
    fun raiseForStatus() {
        if not ok { throw HttpStatusError(status, this) }
    }
    override fun toString(): Text { return "Response({status})" }
}

/// Credentials for the Authorization header. Printing one never shows them.
class Auth(let header: Text) {
    override fun toString(): Text { return "Auth(hidden)" }
    static fun bearer(token: Text): Auth { return Auth("Bearer " + token) }
    /// HTTP basic authentication, encoded as UTF-8.
    static fun basic(user: Text, password: Text): Auth {
        if user.contains(":") { throw InvalidRequestError("A basic auth user name cannot contain ':'.") }
        let joined = user + ":" + password
        return Auth("Basic " + Base64.getEncoder().encodeToString(joined.getBytes(StandardCharsets.UTF_8)))
    }
}

/// One part of a multipart upload. A file is streamed from disk when it is sent.
class Upload(let path: Path?, let data: ByteArray?, let filename: Text, let contentType: Text) {
    static fun file(path: Text, filename: Text? = null, contentType: Text = "application/octet-stream"): Upload {
        var location: Path? = null
        try {
            location = Paths.get(path)
        } catch (error: InvalidPathException) {
            throw InvalidRequestError("This upload path is not valid.")
        }
        let found = location!!
        if not Files.isRegularFile(found) or not Files.isReadable(found) { throw InvalidRequestError("This upload file cannot be read.") }
        return Upload(found, null, filename ?: found.getFileName().toString(), contentType)
    }
    static fun bytes(data: ByteArray, filename: Text, contentType: Text = "application/octet-stream"): Upload {
        return Upload(null, data, filename, contentType)
    }
    static fun text(content: Text, filename: Text, contentType: Text = "text/plain; charset=utf-8"): Upload {
        return Upload(null, content.getBytes(StandardCharsets.UTF_8), filename, contentType)
    }
}

/// What a request inherits from the place it was made.
class Defaults(let client: HttpClient, let headers: TreeMap<Text, Text>, let auth: Auth?)

/// A response whose headers have arrived and whose body has not been read.
class Exchange(let status: Int, let headers: Headers, let url: Text, let stream: InputStream, let remaining: Long)

class Http {
    private static let client: HttpClient = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10L)).build()
    static let plain: Defaults = Defaults(client, TreeMap<Text, Text>(java.lang.String.CASE_INSENSITIVE_ORDER), null)
    // One daemon thread enforces body deadlines for every request.
    private static let timer: ScheduledExecutorService = Executors.newSingleThreadScheduledExecutor { task ->
        let thread = Thread(task, "mammoth-requests-timer")
        thread.setDaemon(true)
        thread
    }

    /// Checks a URL without ever quoting it, since URLs can hold secrets.
    static fun checkUrl(url: Text): URI {
        var parsed: URI? = null
        try {
            parsed = URI(url)
        } catch (error: URISyntaxException) {
            throw InvalidRequestError("This URL is not valid. Encode any spaces or special characters.")
        }
        let uri = parsed!!
        let scheme = uri.getScheme()
        if scheme == null or (not scheme.equalsIgnoreCase("http") and not scheme.equalsIgnoreCase("https")) {
            throw InvalidRequestError("Only http and https URLs are supported.")
        }
        if uri.getHost() == null { throw InvalidRequestError("This URL has no host.") }
        if uri.getRawUserInfo() != null { throw InvalidRequestError("Do not put credentials in a URL. Send them in a header.") }
        return uri
    }

    private static fun encode(text: Text, plus: Bool): Text {
        let encoded = URLEncoder.encode(text, StandardCharsets.UTF_8)
        return if plus { encoded } else { encoded.replace("+", "%20") }
    }

    private static fun plainValue(value: Any?): Text {
        if value is Text { return value }
        if value != null and (value is Bool or value is Number or value is Char) { return value.toString() }
        throw InvalidRequestError("Query and form values must be text, numbers, booleans or lists of those.")
    }

    /// Alternating names and values. A list value repeats its name.
    private static fun flatten(values: JavaMap<Text, *>): MutableList<Text> {
        let out = MutableList<Text>()
        for entry in values.entrySet() {
            let value = entry.getValue()
            var items = MutableList<Any?>()
            if value is JavaCollection<*> {
                for item in value { items.add(item) }
            } else if value != null and value.getClass().isArray() {
                let length = java.lang.reflect.Array.getLength(value)
                for index in 0 until length { items.add(java.lang.reflect.Array.get(value, index)) }
            } else {
                items.add(value)
            }
            for item in items {
                out.add(entry.getKey())
                out.add(plainValue(item))
            }
        }
        return out
    }

    /// `a=1&b=2`, with a list value repeating its key.
    static fun encodePairs(values: JavaMap<Text, *>, plus: Bool): Text {
        let out = StringBuilder()
        let pairs = flatten(values)
        var index = 0
        while index < pairs.size() {
            if out.length() > 0 { out.append("&") }
            out.append(encode(pairs[index], plus))
            out.append("=")
            out.append(encode(pairs[index + 1], plus))
            index += 2
        }
        return out.toString()
    }

    private static fun quoted(text: Text): Text {
        return text.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A")
    }

    private static fun utf8(text: Text): java.net.http.HttpRequest.BodyPublisher {
        return BodyPublishers.ofString(text, StandardCharsets.UTF_8)
    }

    /// A multipart body. Files stay on disk and are read as the body is sent,
    /// and sending it again re-reads them, so it can follow a redirect.
    private static fun multipart(boundary: Text, form: JavaMap<Text, *>?, files: JavaMap<Text, Upload>): java.net.http.HttpRequest.BodyPublisher {
        let parts = MutableList<java.net.http.HttpRequest.BodyPublisher>()
        if form != null {
            let pairs = flatten(form)
            var index = 0
            while index < pairs.size() {
                parts.add(utf8("--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + quoted(pairs[index]) + "\"\r\n\r\n" + pairs[index + 1] + "\r\n"))
                index += 2
            }
        }
        for entry in files.entrySet() {
            let upload = entry.getValue()
            checkHeader("Content-Type", upload.contentType)
            parts.add(utf8("--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + quoted(entry.getKey()) + "\"; filename=\"" + quoted(upload.filename) + "\"\r\nContent-Type: " + upload.contentType + "\r\n\r\n"))
            let location = upload.path
            let data = upload.data
            if location != null {
                try {
                    parts.add(BodyPublishers.ofFile(location))
                } catch (error: FileNotFoundException) {
                    throw InvalidRequestError("This upload file cannot be read.")
                }
            } else if data != null {
                parts.add(BodyPublishers.ofByteArray(data))
            }
            parts.add(utf8("\r\n"))
        }
        parts.add(utf8("--" + boundary + "--\r\n"))
        var joined = parts[0]
        for index in 1 until parts.size() { joined = BodyPublishers.concat(joined, parts[index]) }
        return joined
    }

    /// The URL with `params` added to any query it has, before any fragment.
    static fun withQuery(url: Text, params: JavaMap<Text, *>?): Text {
        if params == null { return url }
        let query = encodePairs(params, false)
        if query.isEmpty() { return url }
        let mark = url.indexOf("#")
        let start = if mark < 0 { url } else { url.substring(0, mark) }
        let fragment = if mark < 0 { "" } else { url.substring(mark) }
        let joiner = if start.indexOf("?") < 0 { "?" } else if start.endsWith("?") or start.endsWith("&") { "" } else { "&" }
        return start + joiner + query + fragment
    }

    private static fun isToken(text: Text): Bool {
        if text.isEmpty() { return false }
        let allowed = "!#$%&'*+-.^_`|~"
        for ch in text.toCharArray() {
            let code = ch.toInt()
            let alphanumeric = (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
            if not alphanumeric and allowed.indexOf(ch.toString()) < 0 { return false }
        }
        return true
    }

    static fun checkHeader(name: Text, value: Text) {
        if not isToken(name) { throw InvalidRequestError("A header name contains a character that is not allowed.") }
        for ch in value.toCharArray() {
            let code = ch.toInt()
            if code == 13 or code == 10 or code == 0 { throw InvalidRequestError("A header value contains a line break or NUL.") }
        }
        let lower = name.toLowerCase()
        if lower == "connection" or lower == "content-length" or lower == "expect" or lower == "host" or lower == "upgrade" {
            throw InvalidRequestError("The {name} header is managed by the HTTP client and cannot be set.")
        }
    }

    /// Checks a session's settings and fixes them for its lifetime.
    static fun sessionDefaults(
        cookies: CookieManager, headers: JavaMap<Text, Text>?, auth: Auth?, timeout: Int, connectTimeout: Int, maxRedirects: Int
    ): Defaults {
        if timeout <= 0 or connectTimeout <= 0 { throw InvalidRequestError("Timeouts must be positive (seconds).") }
        if maxRedirects < 0 { throw InvalidRequestError("maxRedirects cannot be negative.") }
        let shared = TreeMap<Text, Text>(java.lang.String.CASE_INSENSITIVE_ORDER)
        if headers != null { shared.putAll(headers) }
        for entry in shared.entrySet() { checkHeader(entry.getKey(), entry.getValue()) }
        let client = HttpClient.newBuilder()
            .connectTimeout(Duration.ofSeconds(connectTimeout.toLong()))
            .cookieHandler(cookies)
            .build()
        return Defaults(client, shared, auth)
    }

    private static fun origin(uri: URI): Text {
        let scheme = uri.getScheme().toLowerCase()
        var port = uri.getPort()
        if port < 0 { port = if scheme == "https" { 443 } else { 80 } }
        return scheme + "://" + uri.getHost().toLowerCase() + ":" + port
    }

    /// Headers that must never follow a request to another origin.
    private static fun isSensitive(name: Text): Bool {
        let lower = name.toLowerCase()
        for word in ["auth", "cookie", "token", "secret", "password", "api-key", "apikey"] {
            if lower.contains(word) { return true }
        }
        return false
    }

    private static fun redirectTarget(from: URI, location: Text): URI {
        try {
            return checkUrl(from.resolve(URI(location)).toString())
        } catch (error: URISyntaxException) {
            throw RedirectError("The server redirected to an invalid location.")
        } catch (error: InvalidRequestError) {
            throw RedirectError("The server redirected to a location that is not allowed.")
        }
    }

    /// Sends the request and follows redirects, returning once the final
    /// response's headers have arrived. The caller must consume its stream.
    static fun open(
        defaults: Defaults, method: Text, url: Text, timeout: Int, params: JavaMap<Text, *>?, headers: JavaMap<Text, Text>?,
        json: Any?, text: Text?, bytes: ByteArray?, form: JavaMap<Text, *>?, files: JavaMap<Text, Upload>?, auth: Auth?, maxRedirects: Int
    ): Exchange {
        if timeout <= 0 { throw InvalidRequestError("Timeout must be positive (seconds).") }
        if maxRedirects < 0 { throw InvalidRequestError("maxRedirects cannot be negative.") }
        var verb = method.toUpperCase()
        if not isToken(verb) { throw InvalidRequestError("This is not a valid HTTP method.") }
        checkUrl(url)
        var kinds = 0
        if json != null { kinds += 1 }
        if text != null { kinds += 1 }
        if bytes != null { kinds += 1 }
        if form != null or files != null { kinds += 1 }
        if kinds > 1 { throw InvalidRequestError("Give only one of json, text, bytes or form. Only form can be combined with files.") }

        let names = TreeMap<Text, Text>(java.lang.String.CASE_INSENSITIVE_ORDER)
        var publisher = BodyPublishers.noBody()
        var hasBody = kinds > 0
        if json != null {
            names.put("Content-Type", "application/json; charset=utf-8")
            publisher = BodyPublishers.ofString(Json.stringify(json), StandardCharsets.UTF_8)
        } else if text != null {
            names.put("Content-Type", "text/plain; charset=utf-8")
            publisher = BodyPublishers.ofString(text, StandardCharsets.UTF_8)
        } else if bytes != null {
            names.put("Content-Type", "application/octet-stream")
            publisher = BodyPublishers.ofByteArray(bytes)
        } else if files != null {
            let boundary = "mammoth-" + UUID.randomUUID().toString()
            names.put("Content-Type", "multipart/form-data; boundary=" + boundary)
            publisher = multipart(boundary, form, files)
        } else if form != null {
            names.put("Content-Type", "application/x-www-form-urlencoded")
            publisher = BodyPublishers.ofString(encodePairs(form, true), StandardCharsets.UTF_8)
        }
        // Later sources win: library defaults, session headers, session auth,
        // request headers, then request auth.
        names.putAll(defaults.headers)
        let sharedAuth = defaults.auth
        if sharedAuth != null { names.put("Authorization", sharedAuth.header) }
        if headers != null { names.putAll(headers) }
        if auth != null { names.put("Authorization", auth.header) }
        for entry in names.entrySet() { checkHeader(entry.getKey(), entry.getValue()) }

        var target = checkUrl(withQuery(url, params))
        let started = System.nanoTime()
        let limit = TimeUnit.SECONDS.toNanos(timeout.toLong())
        var followed = 0
        while true {
            let reply = exchange(defaults.client, target, verb, names, publisher, limit - (System.nanoTime() - started), timeout)
            let status = reply.statusCode()
            let location = reply.headers().firstValue("location")
            let redirect = status == 301 or status == 302 or status == 303 or status == 307 or status == 308
            if not redirect or maxRedirects == 0 or not location.isPresent() {
                return Exchange(status, Headers(reply.headers().map()), target.toString(), reply.body(), limit - (System.nanoTime() - started))
            }
            closeQuietly(reply.body())
            if followed >= maxRedirects { throw RedirectError("Stopped after following {maxRedirects} redirects.") }
            followed += 1
            let next = redirectTarget(target, location.get())
            // 303 always becomes a read. 301 and 302 turn only POST into GET,
            // as browsers do. 307 and 308 keep the method and body.
            if (status == 303 and verb != "HEAD") or ((status == 301 or status == 302) and verb == "POST") {
                verb = "GET"
                publisher = BodyPublishers.noBody()
                hasBody = false
                names.remove("Content-Type")
            }
            if origin(next) != origin(target) {
                if hasBody { throw RedirectError("Refusing to send this request's body to a different origin.") }
                names.keySet().removeIf { isSensitive(it) }
            }
            target = next
        }
    }

    private static fun exchange(
        client: HttpClient, target: URI, verb: Text, names: TreeMap<Text, Text>,
        publisher: java.net.http.HttpRequest.BodyPublisher, nanos: Long, timeout: Int
    ): HttpResponse<InputStream> {
        if nanos <= 0L { throw TimeoutError("HTTP request timed out after {timeout} seconds.") }
        try {
            let builder = HttpRequest.newBuilder(target).timeout(Duration.ofNanos(nanos))
            for entry in names.entrySet() { builder.setHeader(entry.getKey(), entry.getValue()) }
            builder.method(verb, publisher)
            let sent = client.sendAsync(builder.build(), BodyHandlers.ofInputStream())
            try {
                return sent.get(nanos, TimeUnit.NANOSECONDS)
            } catch (error: TimeoutException) {
                sent.cancel(true)
                throw TimeoutError("HTTP request timed out after {timeout} seconds.", error)
            } catch (error: ExecutionException) {
                throw translate(error.getCause())
            } catch (error: InterruptedException) {
                sent.cancel(true)
                Thread.currentThread().interrupt()
                throw RequestError("HTTP request interrupted.")
            }
        } catch (error: RequestError) {
            throw error
        } catch (error: RuntimeException) {
            throw RequestError("The HTTP request could not be built (" + error.getClass().getSimpleName() + ").")
        }
    }

    static fun request(
        defaults: Defaults, method: Text, url: Text, timeout: Int, params: JavaMap<Text, *>?, headers: JavaMap<Text, Text>?,
        json: Any?, text: Text?, bytes: ByteArray?, form: JavaMap<Text, *>?, files: JavaMap<Text, Upload>?, auth: Auth?, maxRedirects: Int
    ): Response {
        let reply = open(defaults, method, url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
        // Java's own timeout stops at the headers. The body gets what is left.
        let body = readAll(reply.stream, reply.remaining, timeout)
        return Response(reply.status, body, reply.headers, reply.url)
    }

    /// Streams a 2xx body to a temporary file beside `path`, then moves it into
    /// place, so a failed download leaves nothing behind and `path` untouched.
    /// Any other status returns normally, with up to 1 MiB of its body.
    static fun download(
        defaults: Defaults, url: Text, path: Text, timeout: Int, params: JavaMap<Text, *>?, headers: JavaMap<Text, Text>?,
        auth: Auth?, maxRedirects: Int, overwrite: Bool
    ): Response {
        var location: Path? = null
        try {
            location = Paths.get(path).toAbsolutePath()
        } catch (error: InvalidPathException) {
            throw InvalidRequestError("This download path is not valid.")
        }
        let destination = location!!
        let folder = destination.getParent()
        if folder == null or not Files.isDirectory(folder) { throw InvalidRequestError("The folder for this download does not exist.") }
        if Files.isDirectory(destination) { throw InvalidRequestError("The download path is a folder.") }
        if not overwrite and Files.exists(destination) { throw InvalidRequestError("This file already exists. Pass overwrite = true to replace it.") }

        let reply = open(defaults, "GET", url, timeout, params, headers, null, null, null, null, null, auth, maxRedirects)
        if reply.status < 200 or reply.status >= 300 {
            let body = readSome(reply.stream, reply.remaining, timeout)
            return Response(reply.status, body, reply.headers, reply.url)
        }
        let temporary = temporaryFile(folder, reply.stream)
        var moved = false
        try {
            saveStream(reply.stream, temporary, timeout)
            try {
                if overwrite {
                    Files.move(temporary, destination, StandardCopyOption.REPLACE_EXISTING)
                } else {
                    Files.move(temporary, destination)
                }
                moved = true
            } catch (error: FileAlreadyExistsException) {
                throw InvalidRequestError("This file already exists. Pass overwrite = true to replace it.")
            } catch (error: IOException) {
                throw RequestError("The downloaded file could not be moved into place.", error)
            }
        } finally {
            closeQuietly(reply.stream)
            if not moved { deleteQuietly(temporary) }
        }
        return Response(reply.status, emptyBody(), reply.headers, reply.url, destination.toString())
    }

    private static fun emptyBody(): ByteArray { return "".getBytes(StandardCharsets.UTF_8) }

    private static fun temporaryFile(folder: Path, stream: InputStream): Path {
        try {
            return Files.createTempFile(folder, ".mammoth-download-", ".part")
        } catch (error: IOException) {
            closeQuietly(stream)
            throw RequestError("A temporary file for this download could not be created.", error)
        }
    }

    private static fun deleteQuietly(file: Path) {
        try {
            Files.deleteIfExists(file)
        } catch (error: IOException) {
        }
    }

    /// Fails if `timeout` seconds pass with no bytes, however long the whole file takes.
    private static fun saveStream(stream: InputStream, file: Path, timeout: Int) {
        let limit = TimeUnit.SECONDS.toNanos(timeout.toLong())
        let last = AtomicLong(System.nanoTime())
        let expired = AtomicBoolean(false)
        let alarm = timer.scheduleWithFixedDelay(Runnable {
            if System.nanoTime() - last.get() > limit and expired.compareAndSet(false, true) { closeQuietly(stream) }
        }, 100L, 100L, TimeUnit.MILLISECONDS)
        var writing = false
        try {
            let out = Files.newOutputStream(file)
            try {
                let chunk = "x".repeat(65536).getBytes(StandardCharsets.UTF_8)
                while true {
                    writing = false
                    let count = stream.read(chunk)
                    if expired.get() { throw TimeoutError("This download stalled for {timeout} seconds.") }
                    if count < 0 { break }
                    last.set(System.nanoTime())
                    writing = true
                    out.write(chunk, 0, count)
                }
            } finally {
                out.close()
            }
        } catch (error: IOException) {
            if writing { throw RequestError("The downloaded file could not be written.", error) }
            if expired.get() { throw TimeoutError("This download stalled for {timeout} seconds.", error) }
            throw translate(error)
        } finally {
            alarm.cancel(false)
        }
    }

    private static fun readSome(stream: InputStream, nanos: Long, timeout: Int): ByteArray {
        let expired = AtomicBoolean(false)
        let alarm = timer.schedule(Runnable {
            expired.set(true)
            closeQuietly(stream)
        }, if nanos > 0L { nanos } else { 0L }, TimeUnit.NANOSECONDS)
        try {
            let data = stream.readNBytes(1048576)
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.") }
            return data
        } catch (error: IOException) {
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.", error) }
            throw translate(error)
        } finally {
            alarm.cancel(false)
            closeQuietly(stream)
        }
    }

    private static fun closeQuietly(stream: InputStream) {
        try {
            stream.close()
        } catch (error: IOException) {
        }
    }

    /// Reads to the end. At the deadline the stream is closed, which ends a blocked read.
    private static fun readAll(stream: InputStream, nanos: Long, timeout: Int): ByteArray {
        let expired = AtomicBoolean(false)
        let alarm = timer.schedule(Runnable {
            expired.set(true)
            closeQuietly(stream)
        }, if nanos > 0L { nanos } else { 0L }, TimeUnit.NANOSECONDS)
        try {
            let data = stream.readAllBytes()
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.") }
            return data
        } catch (error: IOException) {
            if expired.get() { throw TimeoutError("HTTP request timed out after {timeout} seconds.", error) }
            throw translate(error)
        } finally {
            alarm.cancel(false)
            closeQuietly(stream)
        }
    }

    private static fun translate(error: Throwable?): RequestError {
        if error is HttpTimeoutException {
            return TimeoutError("HTTP request timed out (" + error.getClass().getSimpleName() + ").", error)
        }
        if error is IOException {
            return TransportError("HTTP request failed (" + error.getClass().getSimpleName() + ").", error)
        }
        return RequestError("HTTP request failed.")
    }
}

/// Simple calls: `requests.get(url)`, `requests.post(url, json = value)`.
/// Everything after the URL can be given by name. A method takes any body.
/// Each call stands alone: nothing is shared between them, and no cookies are kept.
/// Redirects are followed only with `maxRedirects`. Nothing is ever retried.
class requests {
    static fun request(method: Text, url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, method, url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun get(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "GET", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun head(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "HEAD", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun options(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "OPTIONS", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun delete(url: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "DELETE", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun post(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "POST", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun put(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "PUT", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun patch(url: Text, json: Any? = null, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = 0): Response {
        return Http.request(Http.plain, "PATCH", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    static fun download(url: Text, path: Text, timeout: Int = 30, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, auth: Auth? = null, maxRedirects: Int = 0, overwrite: Bool = false): Response {
        return Http.download(Http.plain, url, path, timeout, params, headers, auth, maxRedirects, overwrite)
    }
}

/// Shared headers, credentials, timeouts, a cookie store and one connection pool.
/// Its settings are fixed when it is made, so one session can be used from many
/// threads at once. Cookies follow the usual domain and path rules.
class Session(
    headers: JavaMap<Text, Text>? = null, auth: Auth? = null, let timeout: Int = 30, connectTimeout: Int = 10, let maxRedirects: Int = 0
) implements java.io.Closeable {
    private let cookieManager = CookieManager(null, CookiePolicy.ACCEPT_ORIGINAL_SERVER)
    private let closed = AtomicBoolean(false)
    private let defaults: Defaults = Http.sessionDefaults(cookieManager, headers, auth, timeout, connectTimeout, maxRedirects)

    private fun live() {
        if closed.get() { throw InvalidRequestError("This session is closed.") }
    }

    private fun run(
        method: Text, url: Text, chosen: Int, params: JavaMap<Text, *>?, headers: JavaMap<Text, Text>?,
        json: Any?, text: Text?, bytes: ByteArray?, form: JavaMap<Text, *>?, files: JavaMap<Text, Upload>?, auth: Auth?, redirects: Int
    ): Response {
        live()
        return Http.request(defaults, method, url, if chosen == 0 { timeout } else { chosen }, params, headers, json, text, bytes, form, files, auth, if redirects == -1 { maxRedirects } else { redirects })
    }

    fun request(method: Text, url: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run(method, url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun get(url: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("GET", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun head(url: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("HEAD", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun options(url: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("OPTIONS", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun delete(url: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, json: Any? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("DELETE", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun post(url: Text, json: Any? = null, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("POST", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun put(url: Text, json: Any? = null, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("PUT", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun patch(url: Text, json: Any? = null, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, text: Text? = null, bytes: ByteArray? = null, form: JavaMap<Text, *>? = null, files: JavaMap<Text, Upload>? = null, auth: Auth? = null, maxRedirects: Int = -1): Response {
        return run("PATCH", url, timeout, params, headers, json, text, bytes, form, files, auth, maxRedirects)
    }
    fun download(url: Text, path: Text, timeout: Int = 0, params: JavaMap<Text, *>? = null, headers: JavaMap<Text, Text>? = null, auth: Auth? = null, maxRedirects: Int = -1, overwrite: Bool = false): Response {
        live()
        return Http.download(defaults, url, path, if timeout == 0 { this.timeout } else { timeout }, params, headers, auth, if maxRedirects == -1 { this.maxRedirects } else { maxRedirects }, overwrite)
    }

    /// The value of the first stored cookie with this name, or null.
    fun cookie(name: Text): Text? {
        for stored in cookieManager.getCookieStore().getCookies() {
            if stored.getName() == name { return stored.getValue() }
        }
        return null
    }
    /// Every stored cookie as name and value. A repeated name keeps its last value.
    fun cookies(): LinkedHashMap<Text, Text> {
        let result = LinkedHashMap<Text, Text>()
        for stored in cookieManager.getCookieStore().getCookies() { result.put(stored.getName(), stored.getValue()) }
        return result
    }
    /// Stores a cookie to send to `url`'s host for every path.
    fun setCookie(url: Text, name: Text, value: Text) {
        let uri = Http.checkUrl(url)
        try {
            let stored = HttpCookie(name, value)
            stored.setPath("/")
            stored.setVersion(0)
            stored.setDomain(uri.getHost())
            cookieManager.getCookieStore().add(uri, stored)
        } catch (error: IllegalArgumentException) {
            throw InvalidRequestError("This is not a valid cookie name.")
        }
    }
    fun clearCookies() { cookieManager.getCookieStore().removeAll() }
    /// Forgets the cookies and refuses further requests. Connections close when
    /// idle, because Java 17's HTTP client has no way to close them sooner.
    override fun close() {
        closed.set(true)
        clearCookies()
    }
}
