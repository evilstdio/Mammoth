// error: This type argument does not satisfy the bound of its type parameter.
abstract class Animal(let name: Text) { abstract fun sound(): Text }
class Dog(name: Text) extends Animal(name) { override fun sound(): Text { return "woof" } }
fun largest<T: Comparable<T>>(a: T, b: T): T { return a }
print(largest(Dog("a"), Dog("b")).name)
