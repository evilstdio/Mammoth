module stats.Registry
class Registry {
    static var count = 0
    static let name = "registry"
    private static var hidden = 7
    static fun register(item: Text): Int {
        count += 1
        return count * 10 + item.length()
    }
    static fun peek(): Int {
        return hidden
    }
}
class Child extends Registry {
    fun total(): Int {
        return count + peek()
    }
}
