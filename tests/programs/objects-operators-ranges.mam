// Objects, operators, `in`, stepped ranges and raw text.
import java.util.ArrayList
import java.util.HashMap

object Counter {
    var total = 0
    fun add(n: Int): Int {
        total += n
        return total
    }
}
print(Counter.add(2))
print(Counter.add(3))
print(Counter.total)
Counter.total = 10
print(Counter.total)

interface Greeter { fun greet(): Text }
object English implements Greeter {
    override fun greet(): Text = "hello"
}
fun say(greeter: Greeter): Text = greeter.greet()
print(say(English))
let saved: Greeter = English
print(saved.greet())
print(English == English)

sealed class Mode
object On extends Mode
object Off extends Mode
class Level(let n: Int) extends Mode
fun label(mode: Mode): Text = when mode {
    On -> "on"
    Off -> "off"
    is Level -> "level {mode.n}"
}
print(label(On))
print(label(Off))
print(label(Level(3)))

// Operators call named methods.
data class Vec(let x: Int, let y: Int) implements Comparable<Vec> {
    fun plus(other: Vec): Vec = Vec(x + other.x, y + other.y)
    fun minus(other: Vec): Vec = Vec(x - other.x, y - other.y)
    fun times(scale: Int): Vec = Vec(x * scale, y * scale)
    override fun compareTo(other: Vec): Int = x - other.x
}
let a = Vec(1, 2)
let b = Vec(3, 4)
print(a + b)
print(b - a)
print(a * 3)
print(a + b - a)
var moving = a
moving += b
print(moving)
print(a < b)
print(a >= b)

class Grid(let width: Int) {
    let cells = MutableList<Int>()
    init { for i in 0 until width { cells.add(0) } }
    fun get(i: Int): Int = cells[i]
    fun set(i: Int, value: Int) { cells[i] = value }
}
let grid = Grid(3)
grid[1] = 7
print(grid[1] + grid[0])

let javaList = ArrayList<Text>()
javaList.add("zero")
print(javaList[0].length())
javaList[0] = "one"
print(javaList[0])

// in and not in.
let values = MutableList<Int>()
values.add(4)
print(4 in values)
print(5 in values)
print(5 not in values)
print(2 in [1, 2, 3])
print("b" in ["a", "b"])
print("ell" in "hello")
let table = HashMap<Text, Int>()
table.put("k", 1)
print("k" in table)
print("z" in table)
print(3 in 1..5)
print(5 in 1 until 5)
print(9 not in 1..5)
fun side(): Int {
    print("once")
    return 2
}
print(side() in 1..5)
if 2 in values or 4 in values { print("found") }

// Ranges that count down or step.
for i in 3 downTo 1 { print(i) }
for i in 0..6 step 3 { print(i) }
for i in 0 until 6 step 3 { print(i) }
for i in 10 downTo 0 step 5 { print(i) }
for i in 1 downTo 2 { print("never") }
for c in 'a'..'c' step 2 { print(c) }
for i in 1..3 step 1 {
    if i == 2 { continue }
    print(i)
}
for i in 5 downTo 1 {
    if i == 3 { break }
    print(i)
}
// The largest Int ends the loop instead of wrapping around.
var seen = 0
for i in 2147483646..2147483647 step 1 { seen += 1 }
print(seen)
try {
    for i in 0..1 step 0 { print(i) }
} catch (e: IllegalArgumentException) {
    print("bad step")
}

repeat(2) { print("again {it}") }
print(maxOf(2, 3) + minOf(2, 3))

val_text()
fun val_text() {
    let raw = """line "one" {not a value}
\t still raw"""
    print(raw)
    print("""
        kept
          indented
    """.trimIndent())
}
