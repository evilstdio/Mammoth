// else if chains, break, continue, and compound assignment
fun grade(score: Int): Text {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else {
        return "F"
    }
}

for score in [95, 85, 75, 10] {
    print(grade(score))
}

var total = 0
var index = 0
while true {
    index += 1
    if index % 2 == 0 {
        continue
    }
    if index > 9 {
        break
    }
    total += index
}
print(total)

for number in [1, 2, 3, 4, 5, 6] {
    if number == 2 {
        continue
    }
    if number == 5 {
        break
    }
    print(number)
}

var product = 1
product *= 6
product -= 1
product /= 2
product %= 2
print(product)
