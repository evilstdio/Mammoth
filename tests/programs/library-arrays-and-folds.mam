// Conversions to fixed lists, for spreading into a vararg, and more folds.
fun total(vararg xs: Int): Int { return xs.sum() }
fun joined(vararg xs: Text): Text { return xs.joinToString("-") }
let a = listOf(1, 2)
print(total(*a.toIntArray()))
let d: List<Double> = listOf(1.5).toDoubleArray()
print(d[0])
print(joined(*setOf("a", "b").toTypedArray()))
print(listOf(true).toBooleanArray()[0])
print(listOf(5L).toLongArray()[0])
print(listOf('x', 'y').toCharArray().size)
let l = listOf(3, 1, 2)
print(l.max())
print(l.min())
print(l.runningFold(0) { acc, x -> acc + x })
print(l.scan(10) { acc, x -> acc - x })
print(l - 1)
let sb = StringBuilder()
sb.appendLine("a")
sb.appendLine()
print(sb.toString().length)
class P(let a: Int, let b: Text)
let ps = listOf(P(2, "b"), P(1, "z"), P(2, "a"))
print(ps.sortedWith(compareBy({ it.a }, { it.b })).map { "{it.a}{it.b}" })
print(ps.sortedWith(compareBy { it.b }).map { it.b })
