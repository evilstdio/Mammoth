interface I { fun f(): Int
  fun g(a: Int, b: Int, c: Int): Int }
let n = 2
var calls = 0
let i: I = object implements I {
    var count = n0()
    override fun f(): Int {
        count += 1
        calls += 1
        return n + count + g(1, 2, 3)
    }
    override fun g(a: Int, b: Int, c: Int): Int = a + b + c
}
fun n0(): Int = 10
print(i.f())
print(i.f())
print(calls)
let r: Runnable = object implements Runnable { override fun run() { print("r") } }
r.run()
open class A(let x: Int) {
    open fun g(): Int = x
    fun twice(): Int = g() * 2
}
let a: A = object extends A(1) { override fun g(): Int = 5 }
print(a.twice())
import java.util.Comparator
fun sortDown(items: MutableList<Text>) {
    items.sort(object implements Comparator<Text> {
        override fun compare(a: Text, b: Text): Int = b.compareTo(a)
    })
}
let l = mutableListOf("a", "c", "b")
sortDown(l)
print(l)
class Outer(let base: Int) {
    var hits = 0
    fun make(): I {
        return object implements I {
            override fun f(): Int { hits += 1
               return base + hits }
            override fun g(a: Int, b: Int, c: Int): Int { return this.f() + a }
        }
    }
}
let o = Outer(100)
let oi = o.make()
print(oi.f())
print(oi.g(1, 1, 1))
print(o.hits)
listOf(1, 2).forEach { if it == 1 { return@forEach }
 print(it) }
let m = listOf(1, 2).map { if it == 1 { return@map 9 }
 it * 2 }
print(m)
let obj = object { let v = 3
 fun h(): Int = v * 2 }
print(1)
interface J { fun g(x: Int): Int }
let shadow: J = object implements J {
    let x = 10
    override fun g(x: Int): Int = x + this.x
}
print(shadow.g(1))
