import java.util.Random
import java.util.ArrayList
import java.time.LocalDate

print(Math.max(3, 7))
print(Math.abs(-2.5))
print(Integer.MAX_VALUE)
print(Math.PI)
System.out.println("Hello from System.out")
System.out.println(42)
let builder = StringBuilder()
builder.append("Mam").append("moth").append(1).append('!')
print(builder.toString())
print(builder.length())
let random = Random(42)
print(random.nextInt(100))
let items = ArrayList()
items.add("one")
items.add("two")
print(items.size())
print(items)
print("hello world".toUpperCase())
print("a,b,c".matches("[a-c,]+"))
print(String.valueOf(3.5))
print(String.format("%s has %d points", "Maya", 12))
let date = LocalDate.of(2024, 2, 29)
print(date.plusDays(1))
print(date.getDayOfWeek())
let numbers = mutableList(3, 1, 2)
print(numbers.contains(2))
print(numbers.indexOf(1))
print(Thread.currentThread().getName())
print(Character.isLetter('x'))
print(Long.parseLong("123456789012"))
let property: Text? = System.getProperty("does.not.exist")
print(property)
if System.getenv("DOES_NOT_EXIST_123") == null {
    print("no env var")
}
