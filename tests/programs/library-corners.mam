data class P(let a: Int, let b: Text)
print(listOf(P(1, "b"), P(0, "a")).sortedWith(compareBy<P, Int> { it.a }.thenBy { it.b }).map { it.b })
for i in 1L..3L { print(i) }
print(('a'..'c').toList())
print((1L..2L).toList())
print((0..10 step 5).toList())
let r: IntRange = 1..3
print(r.size)
class K
let a = K()
print(a === a)
print(a === K())
print(a !== K())
class F { fun invoke(x: Int): Int = x + 1 }
let f = F()
print(f(1))
let m = mapOf("a" to { x: Int -> x + 1 })
print(m["a"]!!(1))
print(listOf(1, 2).indexOfLast { it == 1 })
print(listOf(1).lastOrNull { it > 0 })
print(listOf(1, 2).dropLast(1))
print(listOf(1, 2).takeLast(1))
print(listOf(1).getOrElse(5) { 0 })
print(listOf(1, 2).foldRight(0) { x, y -> x + y })
print(listOf(1, 2, 3).zipWithNext())
let l = mutableListOf(2, 1)
l.sort()
print(l)
l.reverse()
print(l)
l.removeAll { it == 1 }
print(l)
print(listOf(1).toIntArray().size)
print(mapOf("b" to 1, "a" to 2).toSortedMap())
print(mapOf("a" to 1).any { it.value > 0 })
print(mapOf("a" to 1).all { it.value > 1 })
print(mapOf("a" to 1).count { it.value > 0 })
print(mapOf("a" to 1, "b" to 3).maxByOrNull { it.value }?.key)
mapOf("a" to 1).forEach { (k, v) -> print(k + v.toString()) }
print("a=b=c".substringBefore("="))
print("a=b=c".substringAfter("="))
print("a=b=c".substringBeforeLast("="))
print("a=b=c".substringAfterLast("="))
print("ab".removePrefix("a"))
print("ab".removeSuffix("b"))
print("ab".replaceFirstChar { it.uppercase() })
print("abcde".chunked(2))
print("true".toBoolean())
print("1".toLongOrNull())
print("x".toDoubleOrNull())
print("a".compareTo("B", true))
print("Ab".contains("a", ignoreCase = true))
print("a1b".split(Regex("[0-9]")))
print("a1".replace(Regex("[0-9]"), "x"))
print(1.6.roundToInt())
print(2.0.pow(3))
print((-1).absoluteValue)
print(255.toString(16))
print(maxOf(1, 2, 3))
print(minOf(1.0, 2.0))
print(maxOf(1L, 2L))
