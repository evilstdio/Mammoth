// An endless loop needs no code after it; a top-level throw ends the program.
fun first(limit: Int): Int {
    var n = 0
    while true {
        n += 1
        if n >= limit { return n }
    }
}
print(first(3))
fun withBreak(): Int {
    while true { break }
    return 5
}
print(withBreak())
fun nested(): Int {
    while true {
        while true { break }
        return 2
    }
}
print(nested())
// A global read by a function, called after the declaration, is fine.
let total = 5
fun readTotal(): Int { return total + 1 }
print(readTotal())
class Reader { let seen = readTotal() }
print(Reader().seen)
// A lambda's body runs when it is called, not when it is created.
let later = { x: Int -> x + afterLambda() }
let offset = 40
fun afterLambda(): Int { return offset }
print(later(2))
// A top-level function value can be called inside an expression, and a
// method of the same name inside a class comes first.
let doubler: (Int) -> Int = { x: Int -> x * 2 }
fun useDoubler(): Int { return doubler(4) + 1 }
print(useDoubler())
class HasDoubler {
    fun doubler(x: Int): Int { return x + 100 }
    fun go(): Int { return doubler(1) }
}
print(HasDoubler().go())
// Comparing related classes and subclasses is allowed.
open class A
class B extends A
let a: A = B()
let b = B()
print(a == b)
print(a != A())
try { throw IllegalStateException("x") }
catch (e: IllegalStateException) { print("specific") }
catch (e: RuntimeException) { print("general") }
// A method reading a global is fine once the global is declared.
class LateReader {
    fun get(): Int { return readyLater + 1 }
}
let readyLater = 2
print(LateReader().get())
class Shadows(let readyEarly: Int) {
    fun peek(): Int { return readyEarly }
}
print(Shadows(3).peek())
let readyEarly = 9
