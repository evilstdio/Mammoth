// Infix calls, never-returning functions, ranges as values and more.
infix fun Int.addTo(o: Int): Int = this + o
class V { infix fun plusOne(o: Int): Int = o + 1 }
print(1 + 2 addTo 3 * 2)
print(V() plusOne 1)
fun fail(): Nothing = throw RuntimeException("stop")
fun positive(a: Int?): Int = a ?: fail()
fun onlyOne(a: Int): Text = when (a) {
    1 -> "one"
    else -> fail()
}
print(positive(2))
print(onlyOne(1))
try { onlyOne(2) } catch (e: RuntimeException) { print(e.message) }
let r = 1..3
print(2 in r)
print(r.size)
print((1 until 3).map { it * 2 })
print((3 downTo 1).toList())
fun total(l: MutableList<Int>): Int = l.sum()
print(total(1..4))
class K private constructor(let a: Int) {
    companion object { fun make(): K = K(1) }
}
print(K.make().a)
print(listOf(Pair(1, "a")).map { (n, s) -> s + n.toString() })
print(setOf(1, 2) intersect setOf(2))
print(setOf(1) union setOf(2))
print(setOf(1, 2) subtract setOf(2))
print(listOf("ab").map(Text::length))
data class P(let a: Int)
print(listOf(1).map(::P))
enum E { A, B;
    fun low(): Text = name.lowercase()
}
print(E.entries.size)
print(E.A.low())
print(Regex("[0-9]+").findAll("a1b22"))
print("a".toRegex().matches("a"))
print(5.coerceIn(1, 3))
print(listOf(1, 2).joinToString("-", "[", "]") { (it + 1).toString() })
print(listOf(1, 2, 3).first { it > 1 })
print(listOf(1, 2, 3).last { it < 3 })
print(listOf(1).firstOrNull { it > 1 })
let s = mutableSetOf(1)
s.add(2)
print(s.size)
print("""
    |a
    |b
""".trimMargin())
