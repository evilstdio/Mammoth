// Reads sales records from a temporary file and prints a report, leaning on
// the JDK for dates, money, files, streams and formatting.
import java.math.BigDecimal
import java.math.RoundingMode
import java.nio.file.Files
import java.nio.file.Path
import java.time.LocalDate
import java.time.format.DateTimeFormatter
import java.util.Optional
import java.util.TreeMap
import java.util.stream.Collectors

enum Region(let label: Text) {
    North("N"), South("S"), West("W");

    companion object {
        fun parse(text: Text): Region? = values().firstOrNull { it.label == text }
    }
}

data class Sale(let day: LocalDate, let region: Region, let item: Text, let units: Int, let price: BigDecimal) {
    let total: BigDecimal get() = price * BigDecimal(units)
    fun isBulk(): Bool = units >= 10
}

sealed class Line
data class Good(let sale: Sale) extends Line
data class Bad(let number: Int, let reason: Text) extends Line

class Reader(private let format: DateTimeFormatter) {
    fun parse(number: Int, text: Text): Line {
        val parts = text.split(",").map { it.trim() }
        if parts.size != 5 { return Bad(number, "expected 5 columns, found " + parts.size.toString()) }
        val region = Region.parse(parts[1]) ?: return Bad(number, "unknown region " + parts[1])
        val units = parts[3].toIntOrNull() ?: return Bad(number, "bad units " + parts[3])
        return try {
            Good(Sale(LocalDate.parse(parts[0], format), region, parts[2], units, BigDecimal(parts[4])))
        } catch (e: java.time.format.DateTimeParseException) {
            Bad(number, "bad date")
        } catch (e: NumberFormatException) {
            Bad(number, "bad price")
        }
    }
}

interface Summary<T> {
    let title: Text
    fun add(sale: Sale)
    fun result(): T
}

class TotalByRegion implements Summary<TreeMap<Text, BigDecimal>> {
    override let title: Text = "by region"
    private let totals = TreeMap<Text, BigDecimal>()
    override fun add(sale: Sale) {
        totals.merge(sale.region.name, sale.total, { a: BigDecimal, b: BigDecimal -> a.add(b) })
    }
    override fun result(): TreeMap<Text, BigDecimal> = totals
}

class BestItem implements Summary<Optional<Text>> {
    override let title: Text = "best item"
    private let units = mutableMapOf<Text, Int>()
    override fun add(sale: Sale) {
        units[sale.item] = (units[sale.item] ?: 0) + sale.units
    }
    override fun result(): Optional<Text> {
        val best = units.entries.maxByOrNull { it.value } ?: return Optional.empty()
        return Optional.of(best.key)
    }
}

fun <T> show(summary: Summary<T>, sales: MutableList<Sale>) {
    for sale in sales { summary.add(sale) }
    print(summary.title + ": " + summary.result().toString())
}

val input = """
2026-01-05, N, bolt, 12, 0.25
2026-01-05, S, nut, 3, 0.10
2026-01-07, N, nut, 40, 0.10
2026-01-09, X, bolt, 1, 0.25
2026-02-01, W, gear, x, 3.00
not-a-date, W, gear, 1, 3.00
2026-02-02, W, gear, 2, 3.50
short, line
2026-02-03, S, bolt, 10, abc
""".trim()

val path: Path = Files.createTempFile("mammoth-sales", ".csv")
Files.writeString(path, input)
val reader = Reader(DateTimeFormatter.ISO_LOCAL_DATE)
val lines = Files.readAllLines(path).toMutableList().mapIndexed { index, text -> reader.parse(index + 1, text) }
Files.delete(path)

val sales = lines.mapNotNull { if it is Good { it.sale } else { null } }
val problems = lines.filter { it is Bad }
print(sales.size)
for line in problems {
    when (line) {
        is Bad -> print("line " + line.number.toString() + ": " + line.reason)
        is Good -> print("unexpected")
    }
}

show(TotalByRegion(), sales)
show(BestItem(), sales)

val grand = sales.fold(BigDecimal.ZERO) { sum, sale -> sum + sale.total }
print(grand.setScale(2, RoundingMode.HALF_UP))
print(String.format("%.1f%%", 12.345))

val monthly = sales.groupBy { it.day.getMonth().toString() }
for (month, group) in monthly {
    print(month + " " + group.size.toString() + " " + group.count { it.isBulk() }.toString())
}

val names = sales.stream().map({ s: Sale -> s.item }).distinct().sorted().collect(Collectors.joining("|"))
print(names)
print(sales.sortedByDescending { it.total }.first().item)
print(sales.map { it.units }.filter { it % 2 == 0 }.sum())
print(sales.any { it.region == Region.West })
print(Region.parse("Q") == null)
