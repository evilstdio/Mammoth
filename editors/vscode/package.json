{
  "name": "mammoth-language",
  "displayName": "Mammoth Language",
  "version": "0.1.0",
  "publisher": "evilstdio",
  "preview": true,
  "description": "Syntax highlighting, a run button and compiler errors in the Problems panel for Mammoth, a beginner-friendly language for the JVM.",
  "license": "Apache-2.0 WITH LLVM-exception",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#3B2A20",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evilstdio/Mammoth.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/evilstdio/Mammoth/issues"
  },
  "homepage": "https://github.com/evilstdio/Mammoth#readme",
  "keywords": [
    "mammoth",
    "jvm",
    "java",
    "language",
    "syntax"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes",
    "images/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Running the Mammoth compiler requires a trusted workspace.",
      "restrictedConfigurations": [
        "mammoth.compilerPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "mammoth",
        "aliases": [
          "Mammoth"
        ],
        "extensions": [
          ".mam"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mammoth",
        "scopeName": "source.mammoth",
        "path": "./syntaxes/mammoth.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mammoth.runFile",
        "title": "Run Mammoth File",
        "category": "Mammoth",
        "icon": "$(play)"
      },
      {
        "command": "mammoth.checkJava",
        "title": "Check Java Bindings",
        "category": "Mammoth"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mammoth.runFile",
          "when": "editorLangId == mammoth && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Mammoth",
      "properties": {
        "mammoth.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to the Mammoth compiler. When empty, the extension uses the workspace's target/release compiler, then the Windows setup's install folder, then mammoth on PATH."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "mammoth",
        "required": [
          "operation",
          "file"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "description": "Compiler operation."
          },
          "file": {
            "type": "string",
            "description": "Path to the Mammoth source file."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "mammoth",
        "owner": "mammoth",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ]
  }
}
